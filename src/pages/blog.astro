---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const BATCH = 50;

const allEntries = await getCollection('blog');
const articles = allEntries
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((entry, idx) => ({
    id: entry.id,
    title: entry.data.title,
    date: entry.data.date,
    excerpt: entry.data.excerpt,
    source: entry.data.source,
    url: `/blog/${entry.id}`,
    idx,
  }));

const hasMore = articles.length > BATCH;

// Group by year
const byYear = articles.reduce((acc: Record<string, typeof articles>, article) => {
  const year = article.date.split('-')[0];
  if (!acc[year]) acc[year] = [];
  acc[year].push(article);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

function formatDate(dateStr: string) {
  const [, month, day] = dateStr.split('-');
  const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
  return `${day} ${months[Number(month) - 1]}`;
}
---

<Layout
  title="Blog — Christian Elías Cruz González"
  description="Artículos sobre desarrollo web, frontend, tecnología y comunidad."
>
  <Nav />
  <main class="blog-main">
    <div class="container">

      <header class="blog-header">
        <div class="blog-header-top">
          <div>
            <p class="section-eyebrow">
              <span class="lang-es">Escritura</span>
              <span class="lang-en">Writing</span>
            </p>
            <h1 class="blog-title">Blog</h1>
          </div>
          <div class="blog-meta">
            <span class="blog-count">{articles.length}</span>
            <span class="blog-count-label">
              <span class="lang-es">artículos</span>
              <span class="lang-en">articles</span>
            </span>

          </div>
        </div>
        <p class="blog-desc">
          <span class="lang-es">
            Artículos sobre frontend, tecnología y el oficio de construir software.
            Escritos a lo largo de los años en mi blog personal y en Octa.
          </span>
          <span class="lang-en">
            Articles on frontend, technology, and the craft of building software.
            Written over the years on my personal blog and Octa.
          </span>
        </p>
      </header>

      <div class="blog-body" id="blog-body">
        {years.map((year) => (
          <div class="year-group" data-year={year}>
            <div class="year-label">{year}</div>
            <div class="year-articles">
              {byYear[year].map((article, i) => (
                <a
                  href={article.url}
                  class="article-row"
                  data-idx={article.idx}
                  style={`--i: ${i}`}
                >
                  <span class="article-date">{formatDate(article.date)}</span>
                  <div class="article-body">
                    <div class="article-title-row">
                      <h2 class="article-title">{article.title}</h2>
                    </div>
                    <p class="article-excerpt">{article.excerpt}</p>
                  </div>
                  <span class="article-arrow">→</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      {hasMore && (
        <div class="load-more-wrap">
          <button id="load-more" class="load-more-btn">
            <span class="lang-es">Ver más</span>
            <span class="lang-en">Load more</span>
          </button>
        </div>
      )}

    </div>
  </main>
  <Footer />
</Layout>

<style>
  .blog-main {
    padding-top: 64px;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  /* Header */
  .blog-header {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .blog-header-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .blog-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-top: 0.5rem;
  }

  .blog-meta {
    text-align: right;
    padding-bottom: 0.4rem;
  }

  .blog-count {
    display: block;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .blog-count-label {
    font-size: 0.75rem;
    color: var(--text-2);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .blog-desc {
    font-size: 0.92rem;
    color: var(--text-2);
    line-height: 1.7;
    max-width: 560px;
  }

  .blog-desc a {
    color: var(--text);
    border-bottom: 1px solid var(--border-hover);
    transition: border-color 0.2s, color 0.2s;
  }
  .blog-desc a:hover { color: var(--accent); border-color: var(--accent); }

  /* Body */
  .blog-body {
    padding: 3rem 0 5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Year group */
  .year-group {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0 3rem;
  }

  .year-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    padding-top: 1.4rem;
    position: sticky;
    top: 80px;
    align-self: start;
  }

  .year-articles {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  /* Article row */
  .article-row {
    display: grid;
    grid-template-columns: 64px 1fr 24px;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
    cursor: pointer;
    transition: background 0.15s;
    text-decoration: none;
    border-radius: 4px;
    margin: 0 -1rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .article-row:hover {
    background: var(--surface);
  }

  .article-row:hover .article-title { color: var(--accent); }
  .article-row:hover .article-arrow { opacity: 1; transform: translate(2px, -2px); }

  .article-date {
    font-size: 0.75rem;
    color: var(--text-3);
    font-weight: 500;
    padding-top: 0.25rem;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .article-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .article-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .article-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.3;
    transition: color 0.15s;
  }

  .article-source {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .source-blog {
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid rgba(212, 133, 74, 0.2);
  }

  .source-octa {
    color: var(--text-2);
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  .article-excerpt {
    font-size: 0.82rem;
    color: var(--text-2);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-arrow {
    font-size: 0.85rem;
    color: var(--text-3);
    opacity: 0;
    transition: opacity 0.15s, transform 0.15s;
    padding-top: 0.2rem;
    align-self: start;
  }

  @media (max-width: 700px) {
    .year-group {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .year-label {
      position: static;
      padding-top: 0;
    }
    .article-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      margin: 0;
      padding-left: 0;
      padding-right: 0;
    }
    .article-arrow { display: none; }
    .article-date { padding-top: 0; }
    .blog-header-top { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .blog-meta { text-align: left; }
  }

  .article-row.js-hidden { display: none; }
  .year-group.js-hidden { display: none; }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    padding: 2rem 0 5rem;
  }

  .load-more-btn {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-2);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.625rem 1.75rem;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .load-more-btn:hover {
    border-color: var(--border-hover);
    color: var(--text);
    background: var(--surface);
  }
</style>

<script>
  const BATCH = 50;
  let shown = BATCH;

  function update() {
    const rows = [...document.querySelectorAll<HTMLElement>('.article-row')];
    rows.forEach((r, i) => r.classList.toggle('js-hidden', i >= shown));

    document.querySelectorAll<HTMLElement>('.year-group').forEach((group) => {
      const hasVisible = [...group.querySelectorAll('.article-row')].some(
        (r) => !r.classList.contains('js-hidden')
      );
      group.classList.toggle('js-hidden', !hasVisible);
    });

    const btn = document.getElementById('load-more') as HTMLElement | null;
    if (btn) btn.style.display = shown >= rows.length ? 'none' : '';
  }

  document.getElementById('load-more')?.addEventListener('click', () => {
    shown += BATCH;
    update();
  });

  update();
</script>
