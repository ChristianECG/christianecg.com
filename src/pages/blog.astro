---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const BATCH = 50;

type Article = {
  id: string;
  title: string;
  date: string;
  excerpt: string;
  tags: string[];
  source: string;
  url: string;
  external: boolean;
  idx: number;
};

const allEntries = await getCollection('blog');
const localArticles: Article[] = allEntries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  date: entry.data.date,
  excerpt: entry.data.excerpt,
  tags: [],
  source: entry.data.source,
  url: `/blog/${entry.id}`,
  external: false,
  idx: 0,
}));

let octaArticles: Article[] = [];
try {
  const res = await fetch('https://octa.page/rss.xml');
  const xml = await res.text();
  octaArticles = [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)].flatMap(([, item], i) => {
    const title = item.match(/<title>(.*?)<\/title>/)?.[1]?.trim() ?? '';
    const link  = item.match(/<link>(.*?)<\/link>/)?.[1]?.trim() ?? '';
    const pub   = item.match(/<pubDate>(.*?)<\/pubDate>/)?.[1]?.trim() ?? '';
    const tags  = [...item.matchAll(/<category>(.*?)<\/category>/g)].map(m => m[1]);
    const date  = pub ? new Date(pub).toISOString().split('T')[0] : '';
    if (!title || !date) return [];
    return [{ id: `octa-${i}`, title, date, excerpt: '', tags, source: 'Octa', url: link, external: true, idx: 0 }];
  });
} catch {
  // RSS fetch failed — show only local articles
}

const articles: Article[] = [...localArticles, ...octaArticles]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .map((a, idx) => ({ ...a, idx }));

const featured = articles[0] ?? null;
const restArticles = articles.slice(1);

const hasMore = restArticles.length > BATCH;

const byYear = restArticles.reduce((acc: Record<string, typeof restArticles>, article) => {
  const year = article.date.split('-')[0];
  if (!acc[year]) acc[year] = [];
  acc[year].push(article);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

function formatDate(dateStr: string) {
  const [, month, day] = dateStr.split('-');
  const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
  return `${day} ${months[Number(month) - 1]}`;
}

function formatFullDate(dateStr: string) {
  const [year, month, day] = dateStr.split('-');
  const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
  return `${Number(day)} ${months[Number(month) - 1]} ${year}`;
}
---

<Layout
  title="Blog — Christian Elías Cruz González"
  description="Artículos sobre desarrollo web, frontend, tecnología y comunidad."
  ogImage="https://christianecg.com/og/blog.png"
>
  <Nav />
  <main id="main-content" class="blog-main">
    <div class="container">

      <header class="blog-header reveal">
        <div class="blog-header-top">
          <div>
            <p class="section-eyebrow">
              <span class="lang-es">Escritura</span>
              <span class="lang-en">Writing</span>
            </p>
            <h1 class="blog-title">Blog</h1>
          </div>
          <div class="blog-meta">
            <span class="blog-count">{articles.length}</span>
            <span class="blog-count-label">
              <span class="lang-es">artículos</span>
              <span class="lang-en">articles</span>
            </span>

          </div>
        </div>
        <p class="blog-desc">
          <span class="lang-es">
            Artículos sobre frontend, tecnología y el oficio de construir software.
            Escritos a lo largo de los años en mi blog personal y en Octa.
          </span>
          <span class="lang-en">
            Articles on frontend, technology, and the craft of building software.
            Written over the years on my personal blog and Octa.
          </span>
        </p>
      </header>

      <div class="blog-notice reveal">
        <div class="blog-notice-inner">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/>
          </svg>
          <p>
            <span class="lang-es">
              Los artículos de <a href="https://octa.page" target="_blank" rel="noopener">octa.page</a> aparecen aquí automáticamente — los marcados con <strong>Octa</strong>. Los demás son artículos anteriores de este blog, conservados por razones históricas.
            </span>
            <span class="lang-en">
              Articles from <a href="https://octa.page" target="_blank" rel="noopener">octa.page</a> appear here automatically — those marked <strong>Octa</strong>. The rest are older posts from this blog, kept for historical purposes.
            </span>
          </p>
        </div>
      </div>

      {featured && (
        <a
          href={featured.url}
          class="blog-featured"
          target={featured.external ? '_blank' : undefined}
          rel={featured.external ? 'noopener' : undefined}
        >
          <div class="blog-featured-top">
            <span class="section-eyebrow" style="margin-bottom:0">
              <span class="lang-es">Último artículo</span>
              <span class="lang-en">Latest</span>
            </span>
            <span class="blog-featured-date">{formatFullDate(featured.date)}</span>
          </div>
          <h2 class="blog-featured-title">{featured.title}</h2>
          {featured.excerpt && <p class="blog-featured-excerpt">{featured.excerpt}</p>}
          <div class="blog-featured-footer">
            <div class="article-tags">
              {featured.tags.slice(0, 3).map(tag => (
                <span class="article-tag">{tag}</span>
              ))}
            </div>
            <span class="blog-featured-arrow">{featured.external ? '↗' : '→'}</span>
          </div>
        </a>
      )}

      <div class="blog-body" id="blog-body">
        {years.map((year, yi) => (
          <div class="year-group reveal" data-year={year} style={`--delay: ${yi * 0.08}s`}>
            <div class="year-label">{year}</div>
            <div class="year-articles">
              {byYear[year].map((article, i) => (
                <a
                  href={article.url}
                  class="article-row"
                  data-idx={article.idx}
style={`--i: ${i}`}
                  target={article.external ? '_blank' : undefined}
                  rel={article.external ? 'noopener' : undefined}
                >
                  <span class="article-date">{formatDate(article.date)}</span>
                  <div class="article-body">
                    <div class="article-title-row">
                      <h2 class="article-title">{article.title}</h2>
                      {!article.external && (
                        <span class="article-archive">archivo</span>
                      )}
                    </div>
                    {article.excerpt && <p class="article-excerpt">{article.excerpt}</p>}
                    {article.tags.length > 0 && (
                      <div class="article-tags">
                        {article.tags.slice(0, 4).map(tag => (
                          <span class="article-tag">{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>
                  <span class="article-arrow">{article.external ? '↗' : '→'}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      {hasMore && (
        <div class="load-more-wrap">
          <button id="load-more" class="load-more-btn">
            <span class="lang-es">Ver más</span>
            <span class="lang-en">Load more</span>
          </button>
        </div>
      )}

    </div>
  </main>
  <Footer />
</Layout>

<style>
  .blog-main {
    padding-top: 64px;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  /* Header */
  .blog-header {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .blog-header-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .blog-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-top: 0.5rem;
  }

  .blog-meta {
    text-align: right;
    padding-bottom: 0.4rem;
  }

  .blog-count {
    display: block;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .blog-count-label {
    font-size: 0.75rem;
    color: var(--text-2);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .blog-desc {
    font-size: 0.92rem;
    color: var(--text-2);
    line-height: 1.7;
    max-width: 560px;
  }

  .blog-desc a {
    color: var(--text);
    border-bottom: 1px solid var(--border-hover);
    transition: border-color 0.2s, color 0.2s;
  }
  .blog-desc a:hover { color: var(--accent); border-color: var(--accent); }

  /* Body */
  .blog-body {
    padding: 3rem 0 5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Year group */
  .year-group {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0 3rem;
  }

  .year-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    padding-top: 1.4rem;
    position: sticky;
    top: 80px;
    align-self: start;
  }

  .year-articles {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  /* Article row */
  .article-row {
    display: grid;
    grid-template-columns: 64px 1fr 24px;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s;
    text-decoration: none;
    border-radius: 4px;
    margin: 0 -1rem;
    padding-left: 1rem;
    padding-right: 1rem;
    animation: heroIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(min(var(--i, 0), 10) * 0.05s + 0.15s);
  }

  .article-row:hover {
    background: var(--surface);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .article-row:hover .article-title { color: var(--accent); }
  .article-row:hover .article-arrow { opacity: 1; transform: translate(2px, -2px); }

  .article-date {
    font-size: 0.75rem;
    color: var(--text-3);
    font-weight: 500;
    padding-top: 0.25rem;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .article-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .article-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .article-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.3;
    transition: color 0.15s;
  }

  .article-archive {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--text-3);
    flex-shrink: 0;
    align-self: center;
  }

  .article-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
  }

  .article-tag {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 2px 7px;
    border-radius: 100px;
    background: var(--surface-2);
    color: var(--text-3);
    border: 1px solid var(--border);
  }

  .article-excerpt {
    font-size: 0.82rem;
    color: var(--text-2);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-arrow {
    font-size: 0.85rem;
    color: var(--text-3);
    opacity: 0;
    transition: opacity 0.15s, transform 0.15s;
    padding-top: 0.2rem;
    align-self: start;
  }

  @media (max-width: 700px) {
    .year-group {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .year-label {
      position: static;
      padding-top: 0;
    }
    .article-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      margin: 0;
      padding-left: 0;
      padding-right: 0;
    }
    .article-arrow { display: none; }
    .article-date { padding-top: 0; }
    .blog-header-top { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .blog-meta { text-align: left; }
  }

  /* Notice */
  .blog-notice {
    padding: 1.25rem 0 0;
  }

  .blog-notice-inner {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.85rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    max-width: 600px;
  }

  .blog-notice-inner svg {
    color: var(--text-3);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .blog-notice-inner p {
    font-size: 0.85rem;
    color: var(--text-2);
    line-height: 1.6;
  }

  .blog-notice-inner a {
    color: var(--accent-light);
    border-bottom: 1px solid rgba(130, 170, 255, 0.3);
    transition: color 0.15s, border-color 0.15s;
  }
  .blog-notice-inner a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Featured card */
  .blog-featured {
    display: block;
    margin-top: 2rem;
    padding: 2rem 2.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: border-color 0.25s, background 0.25s, box-shadow 0.25s, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    transform-style: preserve-3d;
  }

  .blog-featured::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .blog-featured:hover {
    border-color: var(--border-hover);
    background: var(--surface-2);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
  }

  .blog-featured:hover::before { transform: scaleY(1); }
  .blog-featured:hover .blog-featured-title { color: var(--accent-light); }
  .blog-featured:hover .blog-featured-arrow { transform: translate(3px, -3px); color: var(--accent); }

  .blog-featured-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .blog-featured-date {
    font-size: 0.75rem;
    color: var(--text-3);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .blog-featured-title {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.75rem;
    transition: color 0.2s;
  }

  .blog-featured-excerpt {
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.75;
    max-width: 640px;
  }

  .blog-featured-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
  }

  .blog-featured-arrow {
    font-size: 1rem;
    color: var(--text-3);
    transition: transform 0.2s, color 0.2s;
    flex-shrink: 0;
  }

  @media (max-width: 700px) {
    .blog-featured { padding: 1.5rem; }
    .blog-featured-top { flex-direction: column; align-items: flex-start; gap: 0.3rem; }
  }

  .article-row.js-hidden { display: none; }
  .year-group { transition-delay: var(--delay, 0s); }
  .year-group.js-hidden { display: none; }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    padding: 2rem 0 5rem;
  }

  .load-more-btn {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-2);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.625rem 1.75rem;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .load-more-btn:hover {
    border-color: var(--border-hover);
    color: var(--text);
    background: var(--surface);
  }
</style>

<script>
  const BATCH = 50;
  let shown = BATCH;

  function update() {
    const rows = [...document.querySelectorAll<HTMLElement>('.article-row')];
    rows.forEach((r, i) => r.classList.toggle('js-hidden', i >= shown));

    document.querySelectorAll<HTMLElement>('.year-group').forEach((group) => {
      const hasVisible = [...group.querySelectorAll('.article-row')].some(
        (r) => !r.classList.contains('js-hidden')
      );
      group.classList.toggle('js-hidden', !hasVisible);
    });

    const btn = document.getElementById('load-more') as HTMLElement | null;
    if (btn) btn.style.display = shown >= rows.length ? 'none' : '';
  }

  document.getElementById('load-more')?.addEventListener('click', () => {
    shown += BATCH;
    update();
  });

  // Featured card tilt
  const featured = document.querySelector<HTMLElement>('.blog-featured');
  if (featured && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const MAX = 4;

    featured.addEventListener('mousemove', (e) => {
      featured.style.transition = 'border-color 0.25s, background 0.25s, box-shadow 0.25s';
      const r = featured.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width  / 2)) / (r.width  / 2);
      const dy = (e.clientY - (r.top  + r.height / 2)) / (r.height / 2);
      featured.style.transform = `perspective(800px) rotateX(${-dy * MAX}deg) rotateY(${dx * MAX}deg)`;
    }, { passive: true });

    featured.addEventListener('mouseleave', () => {
      featured.style.transition = 'border-color 0.25s, background 0.25s, box-shadow 0.25s, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
      featured.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg)';
    });
  }

  update();
</script>
