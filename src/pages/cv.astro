---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="CV — Christian Elías Cruz González"
  description="Currículum vitae de Christian Elías Cruz González, Senior Frontend Engineer."
>
  <Nav />
  <main id="main-content" class="cv-main">
    <div class="container">

      <header class="cv-header reveal">
        <div>
          <p class="section-eyebrow">
            <span class="lang-es">Currículum</span>
            <span class="lang-en">Resume</span>
          </p>
          <h1 class="cv-title">CV</h1>
        </div>
        <a href="/cv.pdf" download class="cv-download">
          <span class="lang-es">↓ Descargar PDF</span>
          <span class="lang-en">↓ Download PDF</span>
        </a>
      </header>

      <div class="cv-embed reveal">
        <iframe
          src="/cv.pdf"
          class="cv-frame"
          title="CV de Christian Elías Cruz González"
        ></iframe>
        <p class="cv-fallback">
          <span class="lang-es">
            Tu navegador no puede mostrar el PDF directamente.
            <a href="/cv.pdf" download>Descárgalo aquí</a>.
          </span>
          <span class="lang-en">
            Your browser can't display the PDF inline.
            <a href="/cv.pdf" download>Download it here</a>.
          </span>
        </p>
      </div>

    </div>
  </main>
  <Footer />
</Layout>

<style>
  .cv-main {
    padding-top: 64px;
    min-height: 100svh;
  }

  .cv-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 4rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .cv-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-top: 0.5rem;
  }

  .cv-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.375rem;
    background: var(--accent-dim);
    border: 1px solid var(--border-hover);
    border-radius: 8px;
    color: var(--accent-light);
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
    margin-bottom: 0.4rem;
  }
  .cv-download:hover {
    background: rgba(91, 140, 245, 0.2);
    border-color: var(--accent);
  }

  .cv-embed {
    padding: 2.5rem 0 5rem;
  }

  .cv-frame {
    width: 100%;
    height: 85vh;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .cv-fallback {
    display: none;
    font-size: 0.875rem;
    color: var(--text-2);
    margin-top: 1rem;
    text-align: center;
  }
  .cv-fallback a {
    color: var(--accent-light);
  }

  @media (max-width: 700px) {
    .cv-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .cv-frame {
      height: 60vh;
    }
    .cv-fallback {
      display: block;
    }
  }
</style>
