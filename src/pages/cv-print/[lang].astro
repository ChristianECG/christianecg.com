---
export const prerender = true;

import { cvData } from '../../data/cv';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'lat' } },
  ];
}

const { lang } = Astro.params;
const cv = cvData[lang as 'es' | 'en' | 'lat'];
const { header, sections } = cv;
---

<!DOCTYPE html>
<html lang={cv.meta.lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{cv.meta.title}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      font-family: 'Georgia', 'Times New Roman', serif;
      font-size: 10.5pt;
      line-height: 1.5;
      color: #111;
      background: #fff;
    }

    body {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      padding: 18mm 18mm 14mm 18mm;
    }

    a { color: inherit; text-decoration: none; }

    /* ── Header ─────────────────────────────────────── */
    .cv-header {
      margin-bottom: 1.4rem;
      border-bottom: 1.5px solid #111;
      padding-bottom: 0.9rem;
    }

    .cv-name {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 20pt;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: 0.25rem;
    }

    .cv-role {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 11pt;
      font-weight: 400;
      color: #444;
      margin-bottom: 0.6rem;
    }

    .cv-location {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 9pt;
      color: #666;
      margin-bottom: 0.2rem;
    }

    .cv-availability {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 8.5pt;
      font-weight: 600;
      color: #222;
      margin-bottom: 0.35rem;
    }

    .cv-contact {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 8.5pt;
      color: #555;
    }

    .cv-contact-sep {
      color: #bbb;
      margin: 0 0.3em;
    }

    /* ── Sections ────────────────────────────────────── */
    .cv-section {
      margin-bottom: 1.2rem;
    }

    .cv-section-title {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 8pt;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #111;
      border-bottom: 0.75px solid #ccc;
      padding-bottom: 0.2rem;
      margin-bottom: 0.75rem;
    }

    /* ── Summary ─────────────────────────────────────── */
    .cv-summary {
      font-size: 9.5pt;
      line-height: 1.65;
      color: #222;
    }

    /* ── Experience ──────────────────────────────────── */
    .cv-job {
      margin-bottom: 1rem;
      page-break-inside: avoid;
    }

    .cv-job-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.15rem;
    }

    .cv-job-title {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 10pt;
      font-weight: 700;
      color: #111;
    }

    .cv-job-period {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 8.5pt;
      color: #555;
      white-space: nowrap;
    }

    .cv-job-company {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 9pt;
      color: #444;
      margin-bottom: 0.4rem;
    }

    .cv-job ul {
      list-style: none;
      padding-left: 0.9rem;
    }

    .cv-job ul li {
      font-size: 9.5pt;
      line-height: 1.6;
      color: #222;
      text-indent: -0.85rem;
    }

    .cv-bullet {
      color: #888;
      margin-right: 0.15rem;
    }

    .cv-job-stack {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 8.5pt;
      color: #555;
      margin-top: 0.4rem;
    }

    .cv-job-stack-label {
      font-weight: 700;
      color: #333;
    }

    /* ── Skills ──────────────────────────────────────── */
    .cv-skills {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 2rem;
    }

    .cv-skill-row {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
    }

    .cv-skill-label {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 8.5pt;
      font-weight: 700;
      color: #111;
    }

    .cv-skill-items {
      font-size: 9pt;
      color: #333;
      line-height: 1.5;
    }

    /* ── Education ───────────────────────────────────── */
    .cv-edu-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }

    .cv-edu-title {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 10pt;
      font-weight: 700;
      color: #111;
    }

    .cv-edu-period {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 8.5pt;
      color: #555;
      white-space: nowrap;
      flex-shrink: 0;
      padding-left: 1rem;
    }

    .cv-edu-institution {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 9pt;
      color: #444;
      margin-top: 0.1rem;
    }

    /* ── Projects ────────────────────────────────────── */
    .cv-project {
      margin-bottom: 0.75rem;
      page-break-inside: avoid;
    }

    .cv-project-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.1rem;
    }

    .cv-project-title {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 9.5pt;
      font-weight: 700;
      color: #111;
    }

    .cv-project-url {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 8pt;
      color: #777;
    }

    .cv-project-desc {
      font-size: 9pt;
      color: #333;
      line-height: 1.55;
    }

    .cv-project-tags {
      font-family: 'Arial', 'Helvetica Neue', sans-serif;
      font-size: 8pt;
      color: #777;
      margin-top: 0.15rem;
    }

    /* ── Two-col bottom ──────────────────────────────── */
    .cv-bottom {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 2.5rem;
    }

    /* ── Languages ───────────────────────────────────── */
    .cv-lang-row {
      display: flex;
      justify-content: space-between;
      font-size: 9pt;
      color: #222;
      padding: 0.2rem 0;
      border-bottom: 0.5px solid #eee;
    }
    .cv-lang-row:last-child { border-bottom: none; }
    .cv-lang-level { color: #666; font-size: 8.5pt; }

    /* ── Activity ────────────────────────────────────── */
    .cv-act-item {
      font-size: 9pt;
      color: #222;
      line-height: 1.55;
      padding: 0.2rem 0 0.2rem 0.9rem;
      border-bottom: 0.5px solid #eee;
      text-indent: -0.85rem;
    }
    .cv-act-item:last-child { border-bottom: none; }

    /* ── Print ───────────────────────────────────────── */
    @page {
      size: A4;
      margin: 18mm 18mm 14mm 18mm;
    }

    @media print {
      body { padding: 0; }
      .cv-job { page-break-inside: avoid; }
    }
  </style>
</head>
<body>

  <header class="cv-header">
    <h1 class="cv-name">{header.name}</h1>
    <p class="cv-role">{header.role}</p>
    <p class="cv-location">{header.location}</p>
    <p class="cv-availability">{header.availability}</p>
    <p class="cv-contact">
      {header.contact.map((item, i) => (
        <>
          {i > 0 && <span class="cv-contact-sep">·</span>}
          <span>{item}</span>
        </>
      ))}
    </p>
  </header>

  <section class="cv-section">
    <h2 class="cv-section-title">{sections.summary.title}</h2>
    <p class="cv-summary">{sections.summary.text}</p>
  </section>

  <section class="cv-section">
    <h2 class="cv-section-title">{sections.experience.title}</h2>
    {sections.experience.jobs.map((job) => (
      <div class="cv-job">
        <div class="cv-job-header">
          <span class="cv-job-title">{job.title}</span>
          <span class="cv-job-period">{job.period}</span>
        </div>
        <p class="cv-job-company">{job.company}</p>
        <ul>
          {job.bullets.map((bullet) => (
            <li><span class="cv-bullet">–</span>{bullet}</li>
          ))}
        </ul>
        <p class="cv-job-stack">
          <span class="cv-job-stack-label">Stack: </span>{job.stack}
        </p>
      </div>
    ))}
  </section>

  <section class="cv-section">
    <h2 class="cv-section-title">{sections.projects.title}</h2>
    {sections.projects.items.map((project) => (
      <div class="cv-project">
        <div class="cv-project-header">
          <span class="cv-project-title">{project.title}</span>
          <span class="cv-project-url">{project.url}</span>
        </div>
        <p class="cv-project-desc">{project.description}</p>
        <p class="cv-project-tags">{project.tags}</p>
      </div>
    ))}
  </section>

  <section class="cv-section">
    <h2 class="cv-section-title">{sections.skills.title}</h2>
    <div class="cv-skills">
      {sections.skills.categories.map((cat) => (
        <div class="cv-skill-row">
          <span class="cv-skill-label">{cat.label}</span>
          <span class="cv-skill-items">{cat.items}</span>
        </div>
      ))}
    </div>
  </section>

  <div class="cv-bottom">
    <section class="cv-section">
      <h2 class="cv-section-title">{sections.education.title}</h2>
      {sections.education.items.map((edu, i) => (
        <div class="cv-edu-header" style={i > 0 ? 'margin-top: 0.6rem;' : ''}>
          <div>
            <div class="cv-edu-header">
              <span class="cv-edu-title">{edu.title}</span>
              <span class="cv-edu-period">{edu.period}</span>
            </div>
            <p class="cv-edu-institution">{edu.institution}</p>
          </div>
        </div>
      ))}
    </section>

    <section class="cv-section">
      <h2 class="cv-section-title">{sections.languages.title}</h2>
      {sections.languages.items.map((lang) => (
        <div class="cv-lang-row">
          <span>{lang.language}</span>
          <span class="cv-lang-level">{lang.level}</span>
        </div>
      ))}
    </section>
  </div>

  <section class="cv-section">
    <h2 class="cv-section-title">{sections.activity.title}</h2>
    {sections.activity.items.map((item) => (
      <p class="cv-act-item"><span class="cv-bullet">–</span><Fragment set:html={item} /></p>
    ))}
  </section>

</body>
</html>
