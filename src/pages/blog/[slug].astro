---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { readingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const mins = readingTime(entry.body ?? '');

function formatDateFull(dateStr: string) {
  const [year, month, day] = dateStr.split('-');
  const months = [
    'Enero','Febrero','Marzo','Abril','Mayo','Junio',
    'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'
  ];
  return `${Number(day)} de ${months[Number(month) - 1]} de ${year}`;
}
---

<Layout
  title={`${entry.data.title} — Christian Elías Cruz González`}
  description={entry.data.excerpt}
  ogType="article"
  ogImage={`https://christianecg.com/og/${entry.id}.png`}
>
  <Nav />
  <main class="article-main">
    <div class="container">

      <article class="article-wrapper">
        <header class="article-header">
          <a href="/blog" class="back-link">
            <span class="back-arrow">←</span>
            <span class="lang-es">Todos los artículos</span>
            <span class="lang-en">All articles</span>
          </a>

          <div class="article-meta">
            <time class="article-date" datetime={entry.data.date}>
              {formatDateFull(entry.data.date)}
            </time>
            <span class="article-reading-time">{mins} min de lectura</span>
          </div>

          <h1 class="article-title">{entry.data.title}</h1>
          <p class="article-excerpt">{entry.data.excerpt}</p>
        </header>

        <div class="article-content prose">
          <Content />
        </div>

        <footer class="article-footer">
          <a href="/blog" class="back-link-bottom">
            <span>←</span>
            <span class="lang-es">Volver al blog</span>
            <span class="lang-en">Back to blog</span>
          </a>
        </footer>
      </article>

    </div>
  </main>
  <Footer />
</Layout>

<style>
  .article-main {
    padding-top: 64px;
    min-height: 100svh;
  }

  .article-wrapper {
    max-width: 680px;
    margin: 0 auto;
    padding: 3rem 0 6rem;
  }

  .article-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-2);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-bottom: 2rem;
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--text); }
  .back-arrow { font-size: 0.9em; }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .article-date {
    font-size: 0.78rem;
    color: var(--text-3);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .article-reading-time {
    font-size: 0.78rem;
    color: var(--text-3);
    font-weight: 500;
  }

  .article-reading-time::before {
    content: '·';
    margin-right: 0.5rem;
    color: var(--text-3);
  }

  .article-source {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 3px;
  }

  .source-blog {
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid rgba(212, 133, 74, 0.2);
  }

  .source-octa {
    color: var(--text-2);
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  .article-title {
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .article-excerpt {
    font-size: 1rem;
    color: var(--text-2);
    line-height: 1.7;
  }

  /* Prose styles */
  .prose {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text);
  }

  .prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .prose :global(h3) {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin: 1.75rem 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .prose :global(p) {
    margin: 0 0 1.25rem;
    color: var(--text);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
    color: var(--text);
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
    line-height: 1.7;
  }

  .prose :global(a) {
    color: var(--accent-light);
    border-bottom: 1px solid rgba(232, 168, 124, 0.3);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .prose :global(a:hover) {
    color: var(--accent);
    border-color: var(--accent);
  }

  .prose :global(code) {
    font-family: 'SF Mono', 'Fira Code', 'Fira Mono', monospace;
    font-size: 0.85em;
    background: var(--surface-2);
    color: var(--accent-light);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .prose :global(pre) {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 0 0 1.5rem;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.85rem;
    color: var(--text);
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    margin: 0 0 1.5rem;
    padding: 0.5rem 0 0.5rem 1.25rem;
    color: var(--text-2);
    font-style: italic;
  }

  .prose :global(em) {
    color: var(--text-2);
    font-style: italic;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 700;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .article-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .back-link-bottom {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-2);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s;
  }
  .back-link-bottom:hover { color: var(--text); }

  @media (max-width: 700px) {
    .article-wrapper {
      padding: 2rem 0 4rem;
    }
    .article-title {
      font-size: 1.6rem;
    }
  }
</style>
