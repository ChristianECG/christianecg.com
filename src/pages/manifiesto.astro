---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="Manifiesto — Christian Elías Cruz González"
  description="En algún punto tocaste una computadora y la computadora hizo lo que querías. Te diste cuenta de que eras un dios."
>
  <Nav />
  <main id="main-content" class="manifesto-main">

    <section class="manifesto-quote">
      <canvas id="mq-canvas" aria-hidden="true"></canvas>

      <div class="container mq-content">
        <p class="eyebrow reveal">
          <span class="lang-es">Manifiesto</span>
          <span class="lang-en">Manifesto</span>
        </p>
        <blockquote class="quote-block reveal" style="--delay: 0.1s">
          <span class="lang-es">
            En algún punto tocaste una computadora y la computadora hizo lo que querías...<br />
            Hiciste que hiciera lo que tú querías, y te diste cuenta de que eras un <em>dios.</em>
          </span>
          <span class="lang-en">
            At some point you touched a computer and the computer did what you wanted...<br />
            You made it do what you wanted it to do, and you realised you were a <em>god.</em>
          </span>
        </blockquote>
        <p class="quote-attribution reveal" style="--delay: 0.25s">
          — <strong>Robert C. Martin</strong>
        </p>
      </div>
    </section>

    <section class="manifesto-beliefs">
      <div class="container">
        <div class="beliefs-header reveal">
          <span class="section-eyebrow">
            <span class="lang-es">Lo que creo</span>
            <span class="lang-en">What I believe</span>
          </span>
          <h2 class="beliefs-heading">
            <span class="lang-es">Principios con los que construyo.</span>
            <span class="lang-en">Principles I build with.</span>
          </h2>
        </div>
        <ul class="beliefs-list">
          <li class="belief reveal" style="--delay: 0s">
            <span class="belief-num">01</span>
            <div class="belief-text">
              <span class="lang-es">El código que nadie nota es el mejor código que existe. Si el usuario no lo ve, funcionó.</span>
              <span class="lang-en">Code nobody notices is the best code there is. If the user doesn't see it, it worked.</span>
            </div>
          </li>
          <li class="belief reveal" style="--delay: 0.08s">
            <span class="belief-num">02</span>
            <div class="belief-text">
              <span class="lang-es">El rendimiento no es una característica. Es respeto. Un segundo de latencia tiene nombre y apellido.</span>
              <span class="lang-en">Performance is not a feature. It's respect. Every second of latency has a face.</span>
            </div>
          </li>
          <li class="belief reveal" style="--delay: 0.16s">
            <span class="belief-num">03</span>
            <div class="belief-text">
              <span class="lang-es">Los usuarios no le deben paciencia al software. El software le debe inteligencia a los usuarios.</span>
              <span class="lang-en">Users don't owe software their patience. Software owes intelligence to its users.</span>
            </div>
          </li>
          <li class="belief reveal" style="--delay: 0.24s">
            <span class="belief-num">04</span>
            <div class="belief-text">
              <span class="lang-es">Escribir código es fácil. Escribir código que otra persona pueda leer sin maldecirte: eso es el oficio.</span>
              <span class="lang-en">Writing code is easy. Writing code another person can read without cursing you: that's the craft.</span>
            </div>
          </li>
          <li class="belief reveal" style="--delay: 0.32s">
            <span class="belief-num">05</span>
            <div class="belief-text">
              <span class="lang-es">La mejor arquitectura es la que desaparece. Estructura que se nota es estructura que estorba.</span>
              <span class="lang-en">The best architecture is the one that disappears. Structure you can see is structure that gets in the way.</span>
            </div>
          </li>
        </ul>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .manifesto-main {
    padding-top: 64px;
  }

  /* ── Quote section ─────────────────────────────────────── */
  .manifesto-quote {
    min-height: calc(100svh - 64px);
    display: flex;
    align-items: center;
    padding: 6rem 0;
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  #mq-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 2s ease 0.3s;
  }
  #mq-canvas.ready { opacity: 1; }

  .mq-content {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 2.5rem;
  }

  .quote-block {
    --delay: 0s;
    transition-delay: var(--delay);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.75rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text);
    max-width: 780px;
    border: none;
    padding: 0;
    margin: 0;
    quotes: none;
  }

  .quote-block em {
    font-style: normal;
    color: var(--accent-light);
  }

  .quote-attribution {
    margin-top: 1.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-3);
    letter-spacing: 0.04em;
  }
  .quote-attribution strong {
    color: var(--text-2);
    font-weight: 600;
  }

  /* ── Beliefs section ───────────────────────────────────── */
  .manifesto-beliefs {
    padding: var(--section-pad) 0;
  }

  .beliefs-header {
    margin-bottom: 3rem;
  }

  .beliefs-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.15;
    margin-top: 0.75rem;
  }

  .beliefs-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    max-width: 820px;
  }

  .belief {
    --delay: 0s;
    transition-delay: var(--delay);
    position: relative;
    padding: 2.5rem 0 2.5rem 0;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    cursor: default;
  }
  .beliefs-list .belief:first-child {
    border-top: 1px solid var(--border);
  }

  /* Accent line that sweeps in on hover */
  .belief::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .belief:hover::before { transform: scaleX(1); }

  /* Large decorative number */
  .belief-num {
    position: absolute;
    top: 0.05em;
    left: -0.08em;
    font-family: var(--font-heading);
    font-size: clamp(5rem, 10vw, 8.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--text);
    opacity: 0.045;
    pointer-events: none;
    user-select: none;
    transition: opacity 0.4s ease, color 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .belief:hover .belief-num {
    opacity: 0.11;
    color: var(--accent);
    transform: scale(1.04) translateY(-2px);
  }

  /* Text sits in front */
  .belief-text {
    position: relative;
    z-index: 1;
    padding-left: 3.25rem;
    padding-top: 1.6rem;
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: var(--text-2);
    line-height: 1.8;
    font-weight: 500;
    max-width: 620px;
    transition: color 0.25s;
  }
  .belief:hover .belief-text { color: var(--text); }

  @media (max-width: 600px) {
    .belief-text { padding-left: 2.25rem; padding-top: 1.4rem; }
    .belief-num  { font-size: clamp(3.5rem, 14vw, 5.5rem); }
  }
</style>

<script>
  const pref    = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas  = document.getElementById('mq-canvas') as HTMLCanvasElement | null;
  const section = document.querySelector<HTMLElement>('.manifesto-quote');

  if (canvas && section && !pref) {
    const ctx = canvas.getContext('2d')!;
    const DPR = Math.min(devicePixelRatio, 2);
    let W = 0, H = 0;

    function resize() {
      W = section.clientWidth;
      H = section.clientHeight;
      canvas.width  = W * DPR;
      canvas.height = H * DPR;
      canvas.style.width  = W + 'px';
      canvas.style.height = H + 'px';
      ctx.scale(DPR, DPR);
      // Fill with bg color on resize to avoid flash
      ctx.fillStyle = '#0B0D12';
      ctx.fillRect(0, 0, W, H);
    }

    resize();

    // ── Flow field ──────────────────────────────────────────
    // Smooth angle at (x, y, t) using two overlapping sin/cos waves
    function fieldAngle(x: number, y: number, t: number): number {
      return (
        Math.sin(x * 0.0045 + t * 0.22) * Math.cos(y * 0.0045 - t * 0.17) +
        Math.cos((x * 0.003) - (y * 0.003) + t * 0.11)
      ) * Math.PI * 2.4;
    }

    // ── Particles ───────────────────────────────────────────
    const COUNT = 550;

    interface Particle {
      x: number; y: number;
      speed: number;
      bright: boolean;
      life: number;
      maxLife: number;
    }

    function makeParticle(randomPos = true): Particle {
      return {
        x: randomPos ? Math.random() * W : Math.random() * W,
        y: randomPos ? Math.random() * H : Math.random() * H,
        speed: 0.55 + Math.random() * 0.9,
        bright: Math.random() < 0.10,
        life: randomPos ? Math.random() * 300 : 0,
        maxLife: 180 + Math.random() * 280,
      };
    }

    const particles: Particle[] = Array.from({ length: COUNT }, () => makeParticle(true));

    let t = 0;
    let raf: number;

    const tick = () => {
      raf = requestAnimationFrame(tick);
      t += 0.0038;

      // Fade previous frame — controls trail length
      ctx.fillStyle = 'rgba(11, 13, 18, 0.032)';
      ctx.fillRect(0, 0, W, H);

      for (const p of particles) {
        const angle = fieldAngle(p.x, p.y, t);
        const nx = p.x + Math.cos(angle) * p.speed;
        const ny = p.y + Math.sin(angle) * p.speed;

        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(nx, ny);

        if (p.bright) {
          ctx.strokeStyle = 'rgba(130, 170, 255, 0.6)';
          ctx.lineWidth = 1.1;
        } else {
          ctx.strokeStyle = 'rgba(232, 237, 245, 0.15)';
          ctx.lineWidth = 0.75;
        }

        ctx.stroke();

        p.x = nx;
        p.y = ny;
        p.life++;

        if (
          p.life > p.maxLife ||
          p.x < -10 || p.x > W + 10 ||
          p.y < -10 || p.y > H + 10
        ) {
          Object.assign(p, makeParticle(true));
          p.life = 0;
        }
      }
    };

    raf = requestAnimationFrame(tick);

    // Fade canvas in after a short delay
    requestAnimationFrame(() => canvas.classList.add('ready'));

    const ro = new ResizeObserver(resize);
    ro.observe(section);

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
    }, { once: true });
  }
</script>
