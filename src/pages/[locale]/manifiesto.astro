---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { LOCALES, useTranslations } from '../../i18n';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const en  = locale === 'en';
const lat = locale === 'lat';

const beliefs = en ? [
  'Code nobody notices is the best code there is. If the user doesn\'t see it, it worked.',
  'Performance is not a feature. It\'s respect. Every second of latency has a face.',
  'Users don\'t owe software their patience. Software owes intelligence to its users.',
  'Writing code is easy. Writing code another person can read without cursing you: that\'s the craft.',
  'The best architecture is the one that disappears. Structure you can see is structure that gets in the way.',
] : lat ? [
  'Codex quem nemo animadvertit optimus codex est. Si utens eum non videt, opus peractum est.',
  'Velocitas non est proprium. Est respectus. Unum secundum latentiae nomen et cognomen habet.',
  'Utentes patientiam softwaro non debent. Softwarum intelligentiam utentibus debet.',
  'Codicem scribere facile est. Codicem scribere quem alius legere possit sine maledictionibus: hoc est ars.',
  'Optima architectura est quae evanescit. Structura quae conspicitur structura est quae impedit.',
] : [
  'El código que nadie nota es el mejor código que existe. Si el usuario no lo ve, funcionó.',
  'El rendimiento no es una característica. Es respeto. Un segundo de latencia tiene nombre y apellido.',
  'Los usuarios no le deben paciencia al software. El software le debe inteligencia a los usuarios.',
  'Escribir código es fácil. Escribir código que otra persona pueda leer sin maldecirte: eso es el oficio.',
  'La mejor arquitectura es la que desaparece. Estructura que se nota es estructura que estorba.',
];
---

<Layout
  title={en ? 'Manifesto — Christian Elías Cruz González' : 'Manifiesto — Christian Elías Cruz González'}
  description="En algún punto tocaste una computadora y la computadora hizo lo que querías. Te diste cuenta de que eras un dios."
  locale={locale}
>
  <Nav locale={locale} />
  <main id="main-content" class="manifesto-main">

    <section class="manifesto-quote">
      <canvas id="mq-canvas" aria-hidden="true"></canvas>

      <div class="container mq-content">
        <p class="eyebrow reveal">{t('manifesto.eyebrow')}</p>
        <blockquote class="quote-block reveal" style="--delay: 0.1s">
          {en ? (
            <>At some point you touched a computer and the computer did what you wanted...<br />You made it do what you wanted it to do, and you realised you were a <em>god.</em></>
          ) : lat ? (
            <>Aliquando machinae computatrici tetigisti et machina id quod volueras fecit...<br />Fecisti ut id ageret quod tu volueras, et intellexisti te <em>deum</em> esse.</>
          ) : (
            <>En algún punto tocaste una computadora y la computadora hizo lo que querías...<br />Hiciste que hiciera lo que tú querías, y te diste cuenta de que eras un <em>dios.</em></>
          )}
        </blockquote>
        <p class="quote-attribution reveal" style="--delay: 0.25s">
          — <strong>Robert C. Martin</strong>
        </p>
      </div>
    </section>

    <section class="manifesto-beliefs">
      <div class="container">
        <div class="beliefs-header reveal">
          <span class="section-eyebrow">{t('manifesto.beliefs_eyebrow')}</span>
          <h2 class="beliefs-heading">{t('manifesto.beliefs_heading')}</h2>
        </div>
        <ul class="beliefs-list">
          {beliefs.map((text, i) => (
            <li class="belief reveal" style={`--delay: ${i * 0.08}s`}>
              <span class="belief-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="belief-text">{text}</div>
            </li>
          ))}
        </ul>
      </div>
    </section>

  </main>
  <Footer locale={locale} />
</Layout>

<style>
  .manifesto-main { padding-top: 64px; }

  .manifesto-quote {
    min-height: calc(100svh - 64px);
    display: flex;
    align-items: center;
    padding: 6rem 0;
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  #mq-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; opacity: 0; transition: opacity 2s ease 0.3s; }
  #mq-canvas.ready { opacity: 1; }
  .mq-content { position: relative; z-index: 1; }

  .eyebrow { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 2.5rem; }

  .quote-block {
    --delay: 0s;
    transition-delay: var(--delay);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.75rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text);
    max-width: 780px;
    border: none;
    padding: 0;
    margin: 0;
    quotes: none;
  }
  .quote-block em { font-style: normal; color: var(--accent-light); }

  .quote-attribution { margin-top: 1.75rem; font-size: 0.8rem; font-weight: 500; color: var(--text-3); letter-spacing: 0.04em; }
  .quote-attribution strong { color: var(--text-2); font-weight: 600; }

  .manifesto-beliefs { padding: var(--section-pad) 0; }
  .beliefs-header { margin-bottom: 3rem; }
  .beliefs-heading { font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; color: var(--text); line-height: 1.15; margin-top: 0.75rem; }
  .beliefs-list { list-style: none; display: flex; flex-direction: column; max-width: 820px; }

  .belief {
    --delay: 0s;
    transition-delay: var(--delay);
    position: relative;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    cursor: default;
  }
  .beliefs-list .belief:first-child { border-top: 1px solid var(--border); }

  .belief::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
  .belief:hover::before { transform: scaleX(1); }

  .belief-num { position: absolute; top: 0.05em; left: -0.08em; font-family: var(--font-heading); font-size: clamp(5rem, 10vw, 8.5rem); font-weight: 800; line-height: 1; letter-spacing: -0.05em; color: var(--text); opacity: 0.045; pointer-events: none; user-select: none; transition: opacity 0.4s ease, color 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
  .belief:hover .belief-num { opacity: 0.11; color: var(--accent); transform: scale(1.04) translateY(-2px); }

  .belief-text { position: relative; z-index: 1; padding-left: 3.25rem; padding-top: 1.6rem; font-size: clamp(0.9rem, 1.5vw, 1.05rem); color: var(--text-2); line-height: 1.8; font-weight: 500; max-width: 620px; transition: color 0.25s; }
  .belief:hover .belief-text { color: var(--text); }

  @media (max-width: 600px) {
    .belief-text { padding-left: 2.25rem; padding-top: 1.4rem; }
    .belief-num { font-size: clamp(3.5rem, 14vw, 5.5rem); }
  }
</style>

<script>
  function initManifesto() {
  const pref    = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas  = document.getElementById('mq-canvas') as HTMLCanvasElement | null;
  const section = document.querySelector<HTMLElement>('.manifesto-quote');

  if (canvas && section && !pref) {
    const ctx = canvas.getContext('2d')!;
    const DPR = Math.min(devicePixelRatio, 2);
    let W = 0, H = 0;

    function resize() {
      W = section.clientWidth; H = section.clientHeight;
      canvas.width = W * DPR; canvas.height = H * DPR;
      canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
      ctx.scale(DPR, DPR);
      ctx.fillStyle = '#0B0D12';
      ctx.fillRect(0, 0, W, H);
    }
    resize();

    function fieldAngle(x: number, y: number, t: number): number {
      return (
        Math.sin(x * 0.0045 + t * 0.22) * Math.cos(y * 0.0045 - t * 0.17) +
        Math.cos((x * 0.003) - (y * 0.003) + t * 0.11)
      ) * Math.PI * 2.4;
    }

    const COUNT = 550;
    interface Particle { x: number; y: number; speed: number; bright: boolean; life: number; maxLife: number; }

    function makeParticle(): Particle {
      return { x: Math.random() * W, y: Math.random() * H, speed: 0.55 + Math.random() * 0.9, bright: Math.random() < 0.10, life: Math.random() * 300, maxLife: 180 + Math.random() * 280 };
    }

    const particles: Particle[] = Array.from({ length: COUNT }, makeParticle);
    let t = 0, raf: number;

    const tick = () => {
      raf = requestAnimationFrame(tick);
      t += 0.0038;
      ctx.fillStyle = 'rgba(11, 13, 18, 0.032)';
      ctx.fillRect(0, 0, W, H);
      for (const p of particles) {
        const angle = fieldAngle(p.x, p.y, t);
        const nx = p.x + Math.cos(angle) * p.speed;
        const ny = p.y + Math.sin(angle) * p.speed;
        ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(nx, ny);
        if (p.bright) { ctx.strokeStyle = 'rgba(130, 170, 255, 0.6)'; ctx.lineWidth = 1.1; }
        else { ctx.strokeStyle = 'rgba(232, 237, 245, 0.15)'; ctx.lineWidth = 0.75; }
        ctx.stroke();
        p.x = nx; p.y = ny; p.life++;
        if (p.life > p.maxLife || p.x < -10 || p.x > W + 10 || p.y < -10 || p.y > H + 10) {
          Object.assign(p, makeParticle()); p.life = 0;
        }
      }
    };

    raf = requestAnimationFrame(tick);
    requestAnimationFrame(() => canvas.classList.add('ready'));
    const ro = new ResizeObserver(resize);
    ro.observe(section);
    document.addEventListener('astro:before-swap', () => { cancelAnimationFrame(raf); ro.disconnect(); }, { once: true });
  }
  }

  document.addEventListener('astro:page-load', initManifesto);
</script>
