---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { LOCALES, useTranslations } from '../../i18n';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const en  = locale === 'en';
const lat = locale === 'lat';
const updated = '2026-08-18';
---

<Layout
  title={en ? 'Now — Christian Elías Cruz González' : 'Ahora — Christian Elías Cruz González'}
  description="What I'm working on, learning, and exploring right now. / Qué estoy haciendo, aprendiendo y explorando en este momento."
  locale={locale}
>
  <Nav locale={locale} />
  <main id="main-content" class="now-main">
    <div class="container">

      <header class="now-header reveal">
        <p class="section-eyebrow">{t('now.eyebrow')}</p>
        <h1 class="now-title">{t('now.heading')}</h1>
        <p class="now-updated">{t('now.last_updated').replace('%s', updated)}</p>
        <p class="now-intro">
          {en ? (
            <>A <a href="https://nownownow.com/about" target="_blank" rel="noopener">/now</a> page is a snapshot of what I'm focused on at this point in my life.</>
          ) : lat ? (
            <>Pagina <a href="https://nownownow.com/about" target="_blank" rel="noopener">/nunc</a> est imago eius quod hoc temporis puncto ago.</>
          ) : (
            <>Una página <a href="https://nownownow.com/about" target="_blank" rel="noopener">/now</a> es un snapshot de lo que estoy haciendo en este momento de mi vida.</>
          )}
        </p>
      </header>

      <div class="now-body">

        <div class="now-section now-section--available reveal" style="--delay: 0s">
          <h2>{t('now.availability')}</h2>
          <div class="now-content">
            <p>
              {en ? (
                <>I'm currently a <strong>Senior Software Engineer at Capital One</strong>, working in a hybrid setup in Mexico City. My focus is on products with real technical complexity: data dashboards, SaaS platforms, and real-time systems.</>
              ) : lat ? (
                <>Nunc <strong>Faber Programmatus Senior apud Capital One</strong> sum, in urbe Mexicana modo hybrido laborans. Propositum meum sunt opera cum vera complexitate technica: tabulae datarum, suggestus SaaS et systemata in tempore reali.</>
              ) : (
                <>Actualmente soy <strong>Ingeniero de Software Senior en Capital One</strong> y trabajo en modalidad híbrida en Ciudad de México. Mi foco está en productos con complejidad técnica real: dashboards de datos, plataformas SaaS y sistemas de tiempo real.</>
              )}
            </p>
          </div>
        </div>

        <div class="now-section reveal" style="--delay: 0.1s">
          <h2>{t('now.working_on')}</h2>
          <div class="now-content">
            <p>
              {en ? (
                <>Building <a href="https://avelor.es" target="_blank" rel="noopener">Avelor</a>, an ecosystem of 17 CLI tools for local development, published on npm under @avelor. Current highlights:</>
              ) : lat ? (
                <>Construo <a href="https://avelor.es" target="_blank" rel="noopener">Avelor</a>, ecosystema XVII instrumentorum CLI pro evolutione locali, in npm sub @avelor editorum. Praecipua nunc:</>
              ) : (
                <>Construyendo <a href="https://avelor.es" target="_blank" rel="noopener">Avelor</a>, un ecosistema de 17 herramientas CLI para desarrollo local, publicadas en npm bajo @avelor. Algunas destacadas:</>
              )}
            </p>
            <ul>
              <li>
                {en ? (
                  <><strong>mesh</strong> — local dev proxy with named services instead of ports, and failure injection without mocks</>
                ) : lat ? (
                  <><strong>mesh</strong> — procurator localis cum nominibus serviciorum pro portis, et iniectio defectuum sine simulacris</>
                ) : (
                  <><strong>mesh</strong> — proxy local con nombres de servicio en lugar de puertos, e inyección de fallos sin mocks</>
                )}
              </li>
              <li>
                {en ? (
                  <><strong>floo</strong> — SSH deployment agent with a GitHub Action and Homebrew tap</>
                ) : lat ? (
                  <><strong>floo</strong> — agens dispositionis per SSH cum actione GitHub et Homebrew tap</>
                ) : (
                  <><strong>floo</strong> — agente de deployment por SSH con GitHub Action y Homebrew tap</>
                )}
              </li>
              <li>
                {en ? (
                  <><strong>bifrost</strong> — self-hosted WebSocket tunnel relay</>
                ) : lat ? (
                  <><strong>bifrost</strong> — relay cuniculorum WebSocket proprio hospitio gestum</>
                ) : (
                  <><strong>bifrost</strong> — relay de túneles WebSocket autoalojado</>
                )}
              </li>
              <li>
                {en ? (
                  <><strong>mira</strong> — uptime monitor with an automatically generated static status page</>
                ) : lat ? (
                  <><strong>mira</strong> — monitor temporis operationis cum pagina statuum statica automatice genita</>
                ) : (
                  <><strong>mira</strong> — monitor de uptime con página de estado estática generada automáticamente</>
                )}
              </li>
            </ul>
            <p style="margin-top: 1.25rem;">
              {en ? (
                <>Also iterating on this site: the CV now ships in seven formats besides the PDF — RFC-style plain text, JSON Resume, a <code>git log -p</code>-style diff, structured logs, a real man page, and a YAML manifest — all generated from the same source data. Added a DNS TXT record as an easter egg (<code>dig TXT cv.christianecg.com</code>) and automated <code>humans.txt</code> to regenerate on every build.</>
              ) : lat ? (
                <>Etiam hanc paginam emendans: curriculum vitae nunc in septem formis praeter PDF praebetur — textus planus more RFC, JSON Resume, discrimen more <code>git log -p</code>, acta structurata, pagina manualis vera, et manifestum YAML — omnia ex eodem fonte generata. Signum DNS TXT ut occultum ludicrum addidi (<code>dig TXT cv.christianecg.com</code>) et <code>humans.txt</code> automatice in quoque aedificio renovari feci.</>
              ) : (
                <>También iterando sobre este sitio: el CV ahora se sirve en siete formatos además del PDF — texto plano estilo RFC, JSON Resume, un diff estilo <code>git log -p</code>, logs estructurados, una man page real, y un manifiesto YAML — todos generados desde el mismo dato fuente. Agregué un registro DNS TXT como easter egg (<code>dig TXT cv.christianecg.com</code>) y automaticé <code>humans.txt</code> para que se regenere en cada build.</>
              )}
            </p>
          </div>
        </div>

        <div class="now-section reveal" style="--delay: 0.2s">
          <h2>{t('now.exploring')}</h2>
          <div class="now-content">
            <p>
              {en ? (
                'Using Claude Code as a daily driver for real development — not just for boilerplate, but for architecture decisions, refactors, and shipping features faster. Also exploring how AI agents fit into personal projects and what that changes about how I scope and build things.'
              ) : lat ? (
                'Claude Code ut instrumentum cotidianum pro evolutione reali utens — non solum pro formulis, sed pro decisionibus architecturae, refacturis et functionalitate citius tradenda. Etiam explorans quomodo agentes AI in opera personalia se inserant et quid hoc mutet in modo quo res amplector et construo.'
              ) : (
                'Usando Claude Code como herramienta diaria para desarrollo real — no solo para boilerplate, sino para decisiones de arquitectura, refactors y lanzar features más rápido. También explorando cómo encajan los agentes de IA en proyectos personales y qué cambia eso en la forma de planear y construir.'
              )}
            </p>
          </div>
        </div>

        <div class="now-section reveal" style="--delay: 0.3s">
          <h2>{t('now.learning')}</h2>
          <div class="now-content">
            <ul>
              <li>
                {en ? 'Software architecture: patterns, design principles, and making better structural decisions in large projects'
                  : lat ? 'Architectura programmatica: exemplaria, principia designationis et meliores decisiones structurales in operibus magnis'
                  : 'Arquitectura de software: patrones, principios de diseño y cómo tomar mejores decisiones estructurales en proyectos grandes'}
              </li>
              <li>
                {en ? 'AI agent architectures and their integration with web applications'
                  : lat ? 'Architecturae agentium AI et earum integratio cum applicationibus retis'
                  : 'Arquitecturas de agentes de IA y su integración con aplicaciones web'}
              </li>
              <li>
                {en ? 'New CSS features: container queries, @layer, anchor positioning'
                  : lat ? 'Novae facultates CSS: interrogationes receptaculi, @layer, positio anchorae'
                  : 'Nuevas características de CSS: container queries, @layer, anchor positioning'}
              </li>
              <li>
                {en ? 'Real DNS semantics (TXT records, propagation) and troff/groff, after turning the CV into a handful of curious-but-functional formats'
                  : lat ? 'Semantica vera DNS (signa TXT, propagatio) et troff/groff, postquam curriculum vitae in aliquot formas curiosas sed functionales verti'
                  : 'Semántica real de DNS (TXT records, propagación) y troff/groff, después de convertir el CV en varios formatos curiosos pero funcionales'}
              </li>
            </ul>
          </div>
        </div>

        <div class="now-section reveal" style="--delay: 0.4s">
          <h2>{t('now.writing')}</h2>
          <div class="now-content">
            <p>
              {en ? 'Documenting thoughts on the frontend craft, AI tooling, and daily learnings on the blog.'
                : lat ? 'Cogitationes de arte frontis, instrumentis AI et discitis cottidianis in commentariis documendo.'
                : 'Documentando reflexiones sobre el oficio del frontend, herramientas de IA y lo que aprendo día a día en el blog.'}
            </p>
          </div>
        </div>

      </div>

    </div>
  </main>
  <Footer locale={locale} />
</Layout>

<style>
  .now-main { padding-top: 64px; min-height: 100svh; }
  .now-header { padding: 4rem 0 3rem; border-bottom: 1px solid var(--border); max-width: 680px; }
  .now-title { font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 800; color: var(--text); letter-spacing: -0.03em; line-height: 1; margin-top: 0.5rem; margin-bottom: 1rem; }
  .now-updated { font-size: 0.78rem; color: var(--text-2); font-weight: 500; letter-spacing: 0.03em; margin-bottom: 1rem; }
  .now-intro { font-size: 0.92rem; color: var(--text-2); line-height: 1.7; }
  .now-intro a { color: var(--accent-light); text-decoration: none; border-bottom: 1px solid rgba(130,170,255,0.3); transition: border-color 0.2s, color 0.2s; }
  .now-intro a:hover { color: var(--accent); border-color: var(--accent); }
  .now-body { max-width: 680px; padding: 3rem 0 6rem; display: flex; flex-direction: column; }
  .now-section { padding: 2rem 0; border-bottom: 1px solid var(--border); transition-delay: var(--delay, 0s); }
  .now-section:first-child { border-top: none; }
  .now-section h2 { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); margin-bottom: 1rem; }
  .now-content p { font-size: 0.95rem; color: var(--text); line-height: 1.8; }
  .now-content ul { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .now-content ul li { font-size: 0.95rem; color: var(--text); line-height: 1.7; padding-left: 1.25rem; position: relative; }
  .now-content ul li::before { content: '—'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }
  .now-section--available { border-left: 2px solid var(--accent); padding-left: 1.25rem; }
  .now-section--available h2 { color: var(--accent); }
  .now-content a { color: var(--accent-light); border-bottom: 1px solid rgba(130,170,255,0.3); transition: border-color 0.2s, color 0.2s; }
  .now-content a:hover { color: var(--accent); border-color: var(--accent); }
  .now-content code { font-family: var(--font-mono, monospace); font-size: 0.82em; background: rgba(130,170,255,0.08); color: var(--accent-light); padding: 0.1em 0.4em; border-radius: 3px; }
</style>
