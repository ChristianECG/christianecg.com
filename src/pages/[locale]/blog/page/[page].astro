---
import Layout from '../../../../layouts/Layout.astro';
import Nav from '../../../../components/Nav.astro';
import Footer from '../../../../components/Footer.astro';
import '../../../../styles/global.css';
import { LOCALES, useTranslations, dataLang } from '../../../../i18n';
import type { Locale } from '../../../../i18n';
import { getAllArticles, paginateArticles, ITEMS_PER_PAGE } from '../../../../utils/blogData';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  const totalPages = Math.ceil((articles.length - 1) / ITEMS_PER_PAGE);

  return LOCALES.flatMap((locale) =>
    Array.from({ length: totalPages - 1 }, (_, i) => ({
      params: { locale, page: String(i + 2) },
    }))
  );
}

const { locale, page: pageParam } = Astro.params as { locale: Locale; page: string };
const t = useTranslations(locale);
const lang = dataLang(locale);
const currentPage = Number(pageParam);

const articles = await getAllArticles();
const { pageArticles, totalPages } = paginateArticles(articles, currentPage);

const byYear = pageArticles.reduce((acc: Record<string, typeof pageArticles>, article) => {
  const year = article.date.split('-')[0];
  if (!acc[year]) acc[year] = [];
  acc[year].push(article);
  return acc;
}, {});
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

const monthsShort: Record<string, string[]> = {
  es:  ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'],
  en:  ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
  lat: ['Ian','Feb','Mar','Apr','Mai','Iun','Iul','Aug','Sep','Oct','Nov','Dec'],
};

function formatDate(dateStr: string) {
  const [, month, day] = dateStr.split('-');
  const m = monthsShort[locale] ?? monthsShort.es;
  return `${day} ${m[Number(month) - 1]}`;
}

function pageUrl(p: number) {
  return p === 1 ? `/${locale}/blog` : `/${locale}/blog/page/${p}`;
}
---

<Layout
  title={`Blog — Página ${currentPage} — Christian Elías Cruz González`}
  description="Artículos sobre desarrollo web, frontend, tecnología y comunidad."
  ogImage="https://christianecg.com/og/blog.png"
  locale={locale}
>
  <Nav locale={locale} />
  <main id="main-content" class="blog-main">
    <div class="container">

      <header class="blog-header reveal">
        <div class="blog-header-top">
          <div>
            <p class="section-eyebrow">{t('blog.eyebrow')}</p>
            <h1 class="blog-title">Blog</h1>
          </div>
          <div class="blog-meta">
            <span class="blog-count">{articles.length}</span>
            <span class="blog-count-label">{t('blog.count_label')}</span>
          </div>
        </div>
      </header>

      <div class="blog-body">
        {years.map((year, yi) => (
          <div class="year-group reveal" data-year={year} style={`--delay: ${yi * 0.08}s`}>
            <div class="year-label">{year}</div>
            <div class="year-articles">
              {byYear[year].map((article, i) => (
                <a
                  href={article.url}
                  class="article-row"
                  style={`--i: ${i}`}
                  target={article.external ? '_blank' : undefined}
                  rel={article.external ? 'noopener' : undefined}
                >
                  <span class="article-date">{formatDate(article.date)}</span>
                  <div class="article-body">
                    <div class="article-title-row">
                      <h2 class="article-title">{article.title}</h2>
                      {!article.external && (
                        <span class="article-archive">archivo</span>
                      )}
                    </div>
                    {article.excerpt && <p class="article-excerpt">{article.excerpt}</p>}
                    {article.tags.length > 0 && (
                      <div class="article-tags">
                        {article.tags.slice(0, 4).map(tag => (
                          <span class="article-tag">{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>
                  <span class="article-arrow">{article.external ? '↗' : '→'}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <nav class="pagination" aria-label="Paginación del blog">
        <span class="pagination-info">
          {t('blog.page_label').replace('%d', String(currentPage)).replace('%d', String(totalPages))}
        </span>
        <div class="pagination-controls">
          <a href={pageUrl(currentPage - 1)} class="pagination-btn">{t('blog.prev')}</a>
          <div class="pagination-pages">
            {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => (
              <a
                href={pageUrl(p)}
                class={`pagination-page${p === currentPage ? ' pagination-page--active' : ''}`}
                aria-current={p === currentPage ? 'page' : undefined}
              >{p}</a>
            ))}
          </div>
          {currentPage < totalPages
            ? <a href={pageUrl(currentPage + 1)} class="pagination-btn">{t('blog.next')}</a>
            : <span class="pagination-btn pagination-btn--disabled" aria-disabled="true">{t('blog.next')}</span>
          }
        </div>
      </nav>

    </div>
  </main>
  <Footer locale={locale} />
</Layout>

<style>
  .blog-main { padding-top: 64px; min-height: 100svh; display: flex; flex-direction: column; }
  .blog-header { padding: 4rem 0 3rem; border-bottom: 1px solid var(--border); }
  .blog-header-top { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 1.25rem; }
  .blog-title { font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 800; color: var(--text); letter-spacing: -0.03em; line-height: 1; margin-top: 0.5rem; }
  .blog-meta { text-align: right; padding-bottom: 0.4rem; }
  .blog-count { display: block; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: var(--accent); letter-spacing: -0.04em; line-height: 1; }
  .blog-count-label { font-size: 0.75rem; color: var(--text-2); font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; }
  .blog-body { padding: 3rem 0 5rem; display: flex; flex-direction: column; gap: 3.5rem; }
  .year-group { display: grid; grid-template-columns: 80px 1fr; gap: 0 3rem; }
  .year-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); padding-top: 1.4rem; position: sticky; top: 80px; align-self: start; }
  .year-articles { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
  .article-row { display: grid; grid-template-columns: 64px 1fr 24px; gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--border); align-items: start; cursor: pointer; transition: background 0.2s, box-shadow 0.2s; text-decoration: none; border-radius: 4px; margin: 0 -1rem; padding-left: 1rem; padding-right: 1rem; animation: heroIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(min(var(--i, 0), 10) * 0.05s + 0.15s); }
  .article-row:hover { background: var(--surface); box-shadow: inset 3px 0 0 var(--accent); }
  .article-row:hover .article-title { color: var(--accent); }
  .article-row:hover .article-arrow { opacity: 1; transform: translate(2px, -2px); }
  .article-date { font-size: 0.75rem; color: var(--text-3); font-weight: 500; padding-top: 0.25rem; white-space: nowrap; letter-spacing: 0.02em; }
  .article-body { display: flex; flex-direction: column; gap: 0.4rem; }
  .article-title-row { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
  .article-title { font-size: 0.95rem; font-weight: 700; color: var(--text); letter-spacing: -0.01em; line-height: 1.3; transition: color 0.15s; }
  .article-archive { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.06em; color: var(--text-3); flex-shrink: 0; align-self: center; }
  .article-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.2rem; }
  .article-tag { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em; padding: 2px 7px; border-radius: 100px; background: var(--surface-2); color: var(--text-3); border: 1px solid var(--border); }
  .article-excerpt { font-size: 0.82rem; color: var(--text-2); line-height: 1.65; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .article-arrow { font-size: 0.85rem; color: var(--text-3); opacity: 0; transition: opacity 0.15s, transform 0.15s; padding-top: 0.2rem; align-self: start; }
  .year-group { transition-delay: var(--delay, 0s); }

  /* Pagination */
  .pagination { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; padding: 0 0 5rem; }
  .pagination-info { font-size: 0.75rem; color: var(--text-3); letter-spacing: 0.04em; }
  .pagination-controls { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; justify-content: center; }
  .pagination-btn { font-size: 0.8rem; font-weight: 500; color: var(--text-2); padding: 0.4rem 0.9rem; border: 1px solid var(--border); border-radius: 6px; text-decoration: none; transition: border-color 0.15s, color 0.15s, background 0.15s; }
  .pagination-btn:hover { border-color: var(--border-hover); color: var(--text); background: var(--surface); }
  .pagination-btn--disabled { color: var(--text-3); pointer-events: none; opacity: 0.4; }
  .pagination-pages { display: flex; gap: 0.25rem; }
  .pagination-page { display: flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; font-size: 0.8rem; font-weight: 500; color: var(--text-2); border: 1px solid var(--border); border-radius: 6px; text-decoration: none; transition: border-color 0.15s, color 0.15s, background 0.15s; }
  .pagination-page:hover { border-color: var(--border-hover); color: var(--text); background: var(--surface); }
  .pagination-page--active { border-color: var(--accent); color: var(--accent); background: var(--surface); pointer-events: none; }

  @media (max-width: 700px) {
    .year-group { grid-template-columns: 1fr; gap: 0.75rem; }
    .year-label { position: static; padding-top: 0; }
    .article-row { grid-template-columns: 1fr; gap: 0.5rem; margin: 0; padding-left: 0; padding-right: 0; }
    .article-arrow { display: none; }
    .article-date { padding-top: 0; }
    .blog-header-top { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .blog-meta { text-align: left; }
  }
</style>
