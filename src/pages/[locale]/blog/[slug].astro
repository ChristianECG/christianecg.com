---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/global.css';
import { LOCALES, useTranslations } from '../../../i18n';
import type { Locale } from '../../../i18n';
import { readingTime } from '../../../utils/readingTime';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return LOCALES.flatMap((locale) =>
    entries.map((entry) => ({
      params: { locale, slug: entry.id },
      props: { entry, locale },
    }))
  );
}

const { locale, entry } = Astro.props as { locale: Locale; entry: any };

// Non-es locales: redirect to the Spanish post with ?from= param
if (locale !== 'es') {
  return Astro.redirect(`/es/blog/${entry.id}?from=${locale}`, 302);
}

const t = useTranslations(locale);
const { Content } = await render(entry);
const mins = readingTime(entry.body ?? '');

function formatDateFull(dateStr: string) {
  const [year, month, day] = dateStr.split('-');
  const months = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  return `${Number(day)} de ${months[Number(month) - 1]} de ${year}`;
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.excerpt,
  datePublished: entry.data.date,
  dateModified: entry.data.date,
  url: `https://christianecg.com/es/blog/${entry.id}`,
  image: `https://christianecg.com/og/${entry.id}.png`,
  author: { '@type': 'Person', name: 'Christian Elías Cruz González', url: 'https://christianecg.com' },
  publisher: { '@type': 'Organization', name: 'christianecg.com', url: 'https://christianecg.com' },
};
---

<Layout
  title={`${entry.data.title} — Christian Elías Cruz González`}
  description={entry.data.excerpt}
  ogType="article"
  ogImage={`https://christianecg.com/og/${entry.id}.png`}
  jsonLd={articleSchema}
  locale={locale}
>
  <div class="progress-bar" id="reading-progress" aria-hidden="true"></div>
  <Nav locale={locale} />
  <main id="main-content" class="article-main">
    <div class="container">

      <!-- Banner: shown by JS when ?from= param is detected -->
      <div id="lang-banner" class="lang-banner" hidden>
        <span class="lang-banner__text" id="lang-banner-text"></span>
        <button class="lang-banner__dismiss" id="lang-banner-dismiss" aria-label="Cerrar">✕</button>
      </div>

      <article class="article-wrapper">
        <header class="article-header">
          <a href="/es/blog" class="back-link">
            <span class="back-arrow">←</span>
            {t('blog.back_to_list')}
          </a>

          <div class="article-meta">
            <time class="article-date" datetime={entry.data.date}>
              {formatDateFull(entry.data.date)}
            </time>
            <span class="article-reading-time">{mins} min de lectura</span>
          </div>

          <h1 class="article-title">{entry.data.title}</h1>
          <p class="article-excerpt">{entry.data.excerpt}</p>
        </header>

        <div class="article-content prose">
          <Content />
        </div>

        <footer class="article-footer">
          <a href="/es/blog" class="back-link-bottom">
            <span>←</span>
            {t('blog.back_link')}
          </a>
        </footer>
      </article>

    </div>
  </main>
  <Footer locale={locale} />
</Layout>

<style>
  .article-main { padding-top: 64px; min-height: 100svh; }

  .lang-banner {
    position: sticky;
    top: 64px;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1.25rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--text-2);
    animation: slideDown 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .lang-banner[hidden] { display: none; }
  .lang-banner__text { flex: 1; line-height: 1.5; }
  .lang-banner__text a { color: var(--accent-light); border-bottom: 1px solid rgba(130,170,255,0.3); transition: color 0.15s, border-color 0.15s; }
  .lang-banner__text a:hover { color: var(--accent); border-color: var(--accent); }
  .lang-banner__dismiss { background: none; border: none; color: var(--text-3); font-size: 0.75rem; cursor: pointer; padding: 2px 6px; border-radius: 4px; transition: color 0.15s, background 0.15s; flex-shrink: 0; }
  .lang-banner__dismiss:hover { color: var(--text); background: var(--surface); }

  @keyframes slideDown { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }

  .article-wrapper { max-width: 680px; margin: 0 auto; padding: 3rem 0 6rem; }

  .article-header { padding-bottom: 2.5rem; border-bottom: 1px solid var(--border); margin-bottom: 2.5rem; }

  .back-link { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-2); text-decoration: none; font-weight: 500; letter-spacing: 0.02em; margin-bottom: 2rem; transition: color 0.15s; }
  .back-link:hover { color: var(--text); }
  .back-arrow { font-size: 0.9em; }

  .article-meta { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
  .article-date { font-size: 0.78rem; color: var(--text-3); font-weight: 500; letter-spacing: 0.03em; }
  .article-reading-time { font-size: 0.78rem; color: var(--text-3); font-weight: 500; }
  .article-reading-time::before { content: '·'; margin-right: 0.5rem; color: var(--text-3); }

  .article-title { font-size: clamp(1.6rem, 4vw, 2.5rem); font-weight: 800; color: var(--text); letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 1rem; }
  .article-excerpt { font-size: 1rem; color: var(--text-2); line-height: 1.7; }

  .prose { font-size: 1rem; line-height: 1.8; color: var(--text); }
  .prose :global(h2) { font-size: 1.25rem; font-weight: 700; color: var(--text); letter-spacing: -0.02em; margin: 2.5rem 0 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); }
  .prose :global(h3) { font-size: 1rem; font-weight: 700; color: var(--text); margin: 1.75rem 0 0.5rem; letter-spacing: -0.01em; }
  .prose :global(p) { margin: 0 0 1.25rem; color: var(--text); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.25rem 1.25rem; color: var(--text); }
  .prose :global(li) { margin-bottom: 0.4rem; line-height: 1.7; }
  .prose :global(a) { color: var(--accent-light); border-bottom: 1px solid rgba(232,168,124,0.3); text-decoration: none; transition: border-color 0.15s, color 0.15s; }
  .prose :global(a:hover) { color: var(--accent); border-color: var(--accent); }
  .prose :global(code) { font-family: 'SF Mono','Fira Code','Fira Mono',monospace; font-size: 0.85em; background: var(--surface-2); color: var(--accent-light); padding: 0.15em 0.4em; border-radius: 3px; border: 1px solid var(--border); }
  .prose :global(pre) { background: var(--surface-2); border: 1px solid var(--border); border-radius: 6px; padding: 1.25rem; overflow-x: auto; margin: 0 0 1.5rem; }
  .prose :global(pre code) { background: none; border: none; padding: 0; font-size: 0.85rem; color: var(--text); }
  .prose :global(blockquote) { border-left: 2px solid var(--accent); margin: 0 0 1.5rem; padding: 0.5rem 0 0.5rem 1.25rem; color: var(--text-2); font-style: italic; }
  .prose :global(em) { color: var(--text-2); font-style: italic; }
  .prose :global(strong) { color: var(--text); font-weight: 700; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }

  .article-footer { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .back-link-bottom { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-2); text-decoration: none; font-weight: 600; transition: color 0.15s; }
  .back-link-bottom:hover { color: var(--text); }

  .prose :global(.copy-btn) { position: absolute; top: 0.6rem; right: 0.6rem; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; color: var(--text-3); font-family: var(--font-body); font-size: 0.7rem; font-weight: 500; padding: 3px 8px; cursor: pointer; opacity: 0; transition: opacity 0.15s, color 0.15s, border-color 0.15s; }
  .prose :global(pre:hover .copy-btn) { opacity: 1; }
  .prose :global(.copy-btn:hover) { color: var(--text); border-color: var(--border-hover); }
  .prose :global(.copy-btn.copied) { color: var(--accent); border-color: var(--accent); opacity: 1; }

  .progress-bar { position: fixed; top: 0; left: 0; height: 2px; width: 0%; background: var(--accent); z-index: 200; transition: width 0.08s linear; pointer-events: none; }

  @media (max-width: 700px) { .article-wrapper { padding: 2rem 0 4rem; } .article-title { font-size: 1.6rem; } }
</style>

<script>
  let progressBound = false;

  function initArticle() {
  // Reading progress bar — bind scroll once, read the live bar element
  function updateProgress() {
    const bar = document.getElementById('reading-progress') as HTMLElement | null;
    if (!bar) return;
    const total = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = total > 0 ? `${(window.scrollY / total) * 100}%` : '0%';
  }
  if (!progressBound) {
    progressBound = true;
    window.addEventListener('scroll', updateProgress, { passive: true });
  }
  updateProgress();

  // Lang banner: show when ?from= param is present
  const from = new URLSearchParams(location.search).get('from');
  if (from) {
    const banner = document.getElementById('lang-banner') as HTMLElement;
    const text = document.getElementById('lang-banner-text') as HTMLElement;
    const dismiss = document.getElementById('lang-banner-dismiss') as HTMLButtonElement;

    const enHref = location.pathname.replace('/es/blog/', '/en/blog/');
    const latHref = location.pathname.replace('/es/blog/', '/lat/blog/');

    if (from === 'en') {
      text.innerHTML = `This post is only available in Spanish. <a href="${enHref}">Go back to English</a>.`;
    } else if (from === 'lat') {
      text.innerHTML = `Hic articulus solum Hispanice scriptus est. <a href="${latHref}">Redi ad Latinum</a>.`;
    } else {
      text.textContent = 'Este artículo solo está disponible en español.';
    }

    banner.removeAttribute('hidden');

    dismiss.addEventListener('click', () => {
      banner.setAttribute('hidden', '');
      history.replaceState(null, '', location.pathname);
    }, { once: true });
  }

  // Copy buttons on code blocks
  document.querySelectorAll('.prose pre').forEach((pre) => {
    if (pre.querySelector('.copy-btn')) return;
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.setAttribute('aria-label', 'Copiar código');
    btn.textContent = 'Copiar';
    (pre as HTMLElement).style.position = 'relative';
    pre.appendChild(btn);
    btn.addEventListener('click', () => {
      const code = pre.querySelector('code')?.textContent ?? '';
      navigator.clipboard.writeText(code).then(() => {
        btn.textContent = '✓';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = 'Copiar'; btn.classList.remove('copied'); }, 2000);
      });
    });
  });
  }

  document.addEventListener('astro:page-load', initArticle);
</script>
