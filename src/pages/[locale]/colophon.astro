---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { LOCALES, useTranslations } from '../../i18n';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const en  = locale === 'en';
const lat = locale === 'lat';
---

<Layout
  title={en ? 'Colophon — Christian Elías Cruz González' : lat ? 'Colophon — Christian Elías Cruz González' : 'Colofón — Christian Elías Cruz González'}
  description="How this site is made: stack, typography, data, and the details nobody asked for. / Cómo está hecho este sitio: stack, tipografía, datos y los detalles que nadie pidió."
  locale={locale}
>
  <Nav locale={locale} />
  <main id="main-content" class="colophon-main">
    <div class="container">

      <header class="colophon-header reveal">
        <p class="section-eyebrow">{t('colophon.eyebrow')}</p>
        <h1 class="colophon-title">{t('colophon.heading')}</h1>
        <p class="colophon-intro">
          {en ? (
            <>A colophon is the note at the end of a book that tells you how it was made. This is this site's.</>
          ) : lat ? (
            <>Colophon est nota in fine libri quae narrat quomodo factus sit. Haec est huius sedis.</>
          ) : (
            <>Un colofón es la nota al final de un libro que cuenta cómo fue hecho. Este es el de este sitio.</>
          )}
        </p>
      </header>

      <div class="colophon-body">

        <div class="colophon-section reveal" style="--delay: 0s">
          <h2>{t('colophon.stack')}</h2>
          <div class="colophon-content">
            <ul>
              <li>
                {en ? (
                  <>Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>. Fully static: every page is plain HTML and CSS, with no client-side framework.</>
                ) : lat ? (
                  <>Aedificatum cum <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>. Omnino staticum: quaeque pagina merum HTML et CSS est, sine framework in cliente.</>
                ) : (
                  <>Construido con <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>. Completamente estático: cada página es HTML y CSS puro, sin framework en el cliente.</>
                )}
              </li>
              <li>
                {en ? (
                  <>Deployed to GitHub Pages via GitHub Actions on every push.</>
                ) : lat ? (
                  <>In GitHub Pages per GitHub Actions cum quoque impulsu editum.</>
                ) : (
                  <>Desplegado a GitHub Pages con GitHub Actions en cada push.</>
                )}
              </li>
              <li>
                {en ? (
                  <>Content lives in TypeScript and Markdown files inside the repo. There is no CMS: the editor is the editor.</>
                ) : lat ? (
                  <>Contentum in scriptis TypeScript et Markdown intra repositorium vivit. Nullum CMS est: editor est editor.</>
                ) : (
                  <>El contenido vive en archivos TypeScript y Markdown dentro del repo. No hay CMS: el editor es el editor.</>
                )}
              </li>
            </ul>
          </div>
        </div>

        <div class="colophon-section reveal" style="--delay: 0.1s">
          <h2>{t('colophon.typography')}</h2>
          <div class="colophon-content">
            <ul>
              <li>
                {en ? (
                  <><strong>Bricolage Grotesque</strong> for headings, <strong>Inter</strong> for body text, and <strong>Lora</strong> for long-form reading pages.</>
                ) : lat ? (
                  <><strong>Bricolage Grotesque</strong> pro titulis, <strong>Inter</strong> pro textu corporis, et <strong>Lora</strong> pro paginis longae lectionis.</>
                ) : (
                  <><strong>Bricolage Grotesque</strong> para títulos, <strong>Inter</strong> para el cuerpo y <strong>Lora</strong> para las páginas de lectura larga.</>
                )}
              </li>
              <li>
                {en ? (
                  <>Fonts are self-hosted — no requests to third parties. The dark palette is a handful of CSS custom properties.</>
                ) : lat ? (
                  <>Litterae in ipsa sede hospitantur — nullae petitiones ad tertios. Colores obscuri paucae proprietates CSS sunt.</>
                ) : (
                  <>Las fuentes son self-hosted — cero peticiones a terceros. La paleta oscura son un puñado de custom properties de CSS.</>
                )}
              </li>
            </ul>
          </div>
        </div>

        <div class="colophon-section reveal" style="--delay: 0.2s">
          <h2>{t('colophon.data_api')}</h2>
          <div class="colophon-content">
            <ul>
              <li>
                {en ? (
                  <>Everything on this site is also machine-readable: a public <a href={`/${locale}/api`}>JSON API</a>, <a href="/rss.xml">RSS</a>, <a href="/feed.json">JSON Feed</a>, and <a href="/llms.txt">llms.txt</a>.</>
                ) : lat ? (
                  <>Omnia in hac sede etiam machinis legibilia sunt: <a href={`/${locale}/api`}>API JSON</a> publica, <a href="/rss.xml">RSS</a>, <a href="/feed.json">JSON Feed</a>, et <a href="/llms.txt">llms.txt</a>.</>
                ) : (
                  <>Todo lo que hay en este sitio también es legible por máquinas: una <a href={`/${locale}/api`}>API JSON</a> pública, <a href="/rss.xml">RSS</a>, <a href="/feed.json">JSON Feed</a> y <a href="/llms.txt">llms.txt</a>.</>
                )}
              </li>
              <li>
                {en ? (
                  <>Social preview images are generated at build time with Satori and resvg — one per page, no design tool involved.</>
                ) : lat ? (
                  <>Imagines sociales tempore aedificationis cum Satori et resvg generantur — una pro quaque pagina, sine instrumento designandi.</>
                ) : (
                  <>Las imágenes de preview social se generan en build con Satori y resvg — una por página, sin herramienta de diseño de por medio.</>
                )}
              </li>
              <li>
                {en ? (
                  <>The CV exists as a print-ready page that Playwright turns into PDFs in three languages.</>
                ) : lat ? (
                  <>Curriculum vitae ut pagina imprimenda exsistit, quam Playwright in PDF tribus linguis convertit.</>
                ) : (
                  <>El CV existe como una página lista para imprimir que Playwright convierte a PDF en tres idiomas.</>
                )}
              </li>
            </ul>
          </div>
        </div>

        <div class="colophon-section reveal" style="--delay: 0.3s">
          <h2>{t('colophon.quality')}</h2>
          <div class="colophon-content">
            <ul>
              <li>
                {en ? (
                  <>An accessibility audit (axe-core over every key page) runs as a pre-commit hook. If a page fails, the commit doesn't happen.</>
                ) : lat ? (
                  <>Inspectio accessibilitatis (axe-core super quamque paginam praecipuam) ut hamus pre-commit currit. Si pagina deficit, commissum non fit.</>
                ) : (
                  <>Una auditoría de accesibilidad (axe-core sobre cada página clave) corre como hook de pre-commit. Si una página falla, el commit no entra.</>
                )}
              </li>
              <li>
                {en ? (
                  <>No analytics, no cookies, no trackers. If you're reading this, I have no idea — and that's fine.</>
                ) : lat ? (
                  <>Nulla analytica, nulla crustula, nulli vestigatores. Si hoc legis, nescio — et bene est.</>
                ) : (
                  <>Sin analytics, sin cookies, sin trackers. Si estás leyendo esto, no tengo idea — y está bien así.</>
                )}
              </li>
            </ul>
          </div>
        </div>

        <div class="colophon-section reveal" style="--delay: 0.4s">
          <h2>{t('colophon.details')}</h2>
          <div class="colophon-content">
            <p>
              {en ? (
                <>The whole site is available in Spanish, English, and <a href="/lat/">Latin</a>. Yes, Latin. Somebody had to.</>
              ) : lat ? (
                <>Tota sedes Hispanice, Anglice et <a href="/lat/">Latine</a> praesto est. Ita, Latine. Aliquis facere debebat.</>
              ) : (
                <>Todo el sitio está disponible en español, inglés y <a href="/lat/">latín</a>. Sí, latín. Alguien tenía que hacerlo.</>
              )}
            </p>
          </div>
        </div>

      </div>

    </div>
  </main>
  <Footer locale={locale} />
</Layout>

<style>
  .colophon-main { padding-top: 64px; min-height: 100svh; }
  .colophon-header { padding: 4rem 0 3rem; border-bottom: 1px solid var(--border); max-width: 680px; }
  .colophon-title { font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 800; color: var(--text); letter-spacing: -0.03em; line-height: 1; margin-top: 0.5rem; margin-bottom: 1rem; }
  .colophon-intro { font-size: 0.92rem; color: var(--text-2); line-height: 1.7; }
  .colophon-body { max-width: 680px; padding: 3rem 0 6rem; display: flex; flex-direction: column; }
  .colophon-section { padding: 2rem 0; border-bottom: 1px solid var(--border); transition-delay: var(--delay, 0s); }
  .colophon-section h2 { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); margin-bottom: 1rem; }
  .colophon-content p { font-size: 0.95rem; color: var(--text); line-height: 1.8; }
  .colophon-content ul { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .colophon-content ul li { font-size: 0.95rem; color: var(--text); line-height: 1.7; padding-left: 1.25rem; position: relative; }
  .colophon-content ul li::before { content: '—'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }
  .colophon-content a { color: var(--accent-light); text-decoration: none; border-bottom: 1px solid rgba(130,170,255,0.3); transition: border-color 0.2s, color 0.2s; }
  .colophon-content a:hover { color: var(--accent); border-color: var(--accent); }
</style>
