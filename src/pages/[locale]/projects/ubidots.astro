---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import Lightbox from '../../../components/Lightbox.astro';
import '../../../styles/global.css';
import { LOCALES } from '../../../i18n';
import type { Locale } from '../../../i18n';
import stripe1 from '../../../assets/ubidots/stripe1.png';
import stripe2 from '../../../assets/ubidots/stripe2.png';
import linechartAnnotations from '../../../assets/ubidots/linechart_anotations.png';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const project = await getEntry('projects', 'ubidots');
const { title, description, tags } = project.data;

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  url: `https://christianecg.com/${locale}/projects/ubidots`,
  image: 'https://christianecg.com/og/project/ubidots.png',
  keywords: tags.join(', '),
  author: {
    '@type': 'Person',
    name: 'Christian Elías Cruz González',
    url: 'https://christianecg.com',
  },
};
---

<Layout
  title={`${title} — Case Study · Christian Elías`}
  description={description}
  ogImage="https://christianecg.com/og/project/ubidots.png"
  jsonLd={projectSchema}
  locale={locale}
>
  <Nav locale={locale} />
  <main id="main-content" class="cs-main">
    <div class="container">

      <header class="cs-header reveal">
        <a href={`/${locale}/#experience`} class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span class="lang-es">Experiencia</span>
          <span class="lang-en">Experience</span>
          <span class="lang-lat">Experientia</span>
        </a>

        <div class="cs-title-row">
          <h1 class="cs-title">Ubidots</h1>
          <a href="https://ubidots.com" target="_blank" rel="noopener" class="cs-external">
            ubidots.com
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>

        <p class="cs-tagline lang-es">
          Plataforma IoT con +150K usuarios y millones de eventos en tiempo real. En Ubidots desde 2022 · Senior Software Engineer desde Feb 2024.
        </p>
        <p class="cs-tagline lang-en">
          IoT platform with 150K+ users and millions of real-time events. At Ubidots since 2022 · Senior Software Engineer since Feb 2024.
        </p>
        <p class="cs-tagline lang-lat">
          Suggestus IoT cum CL milibus utentium et milia eventuum in tempore reali. Apud Ubidots ab anno MMXXII · Faber Programmatus Senior ab Feb. MMXXIV.
        </p>

        <div class="cs-tags">
          {tags.map(tag => (
            <span class="cs-tag">{tag}</span>
          ))}
        </div>

        <p class="cs-disclaimer lang-es">
          El código es privado. Las capturas provienen de la documentación pública de Ubidots.
        </p>
        <p class="cs-disclaimer lang-en">
          The codebase is private. Screenshots are from Ubidots' public documentation.
        </p>
        <p class="cs-disclaimer lang-lat">
          Codex privatus est. Imagines ex documentis publicis Ubidots sumptae sunt.
        </p>
      </header>

      <div class="cs-divider"></div>

      <!-- Impact metrics -->
      <section class="cs-section reveal">
        <div class="cs-section-label">
          <span class="lang-es">Impacto</span>
          <span class="lang-en">Impact</span>
          <span class="lang-lat">Effectus</span>
        </div>
        <div class="cs-metrics">
          <div class="metric">
            <span class="metric-num">−37%</span>
            <span class="metric-label lang-es">tiempo de carga en dashboards<br/><span class="metric-sub">8s → 5s</span></span>
            <span class="metric-label lang-en">dashboard load time<br/><span class="metric-sub">8s → 5s</span></span>
            <span class="metric-label lang-lat">tempus onerationis dascifoliorum<br/><span class="metric-sub">8s → 5s</span></span>
          </div>
          <div class="metric">
            <span class="metric-num">−50%</span>
            <span class="metric-label lang-es">tiempo de render en widgets ECharts<br/><span class="metric-sub">30s → &lt;15s</span></span>
            <span class="metric-label lang-en">ECharts widget render time<br/><span class="metric-sub">30s → &lt;15s</span></span>
            <span class="metric-label lang-lat">tempus reddendi ECharts<br/><span class="metric-sub">30s → &lt;15s</span></span>
          </div>
          <div class="metric">
            <span class="metric-num">−60%</span>
            <span class="metric-label lang-es">tiempo de despliegue<br/><span class="metric-sub">50 min → 20 min</span></span>
            <span class="metric-label lang-en">deployment time<br/><span class="metric-sub">50 min → 20 min</span></span>
            <span class="metric-label lang-lat">tempus dispositionis<br/><span class="metric-sub">50 min → 20 min</span></span>
          </div>
        </div>
      </section>

      <div class="cs-divider"></div>

      <!-- Module 1: Billing -->
      <section class="cs-section reveal">
        <div class="cs-section-label">
          <span class="lang-es">Módulo 01</span>
          <span class="lang-en">Module 01</span>
          <span class="lang-lat">Modulus 01</span>
        </div>
        <div class="cs-module">
          <div class="cs-module-text">
            <h2 class="cs-module-title">
              <span class="lang-es">Billing y monetización</span>
              <span class="lang-en">Billing & monetization</span>
              <span class="lang-lat">Facturatio et monetizatio</span>
            </h2>
            <div class="cs-prose">
              <p class="lang-es">
                Diseñé e implementé desde cero el sistema de pagos y suscripciones de la plataforma, integrado con Stripe. Permite a los usuarios de Ubidots crear sus propias apps y monetizarlas — definiendo planes con precios fijos o usage-based (por dispositivo, variable o mensaje), ciclos de facturación, y múltiples monedas.
              </p>
              <p class="lang-en">
                Designed and built the platform's billing and subscription system from scratch, integrated with Stripe. It allows Ubidots users to create their own apps and monetize them — defining plans with fixed or usage-based pricing (per device, variable, or message), billing cycles, and multiple currencies.
              </p>
              <p class="lang-lat">
                Systema solutionis pecuniariae et subscriptionum a fundamentis designavi et exsecutioni dedi, cum Stripe coniunctum. Utentes Ubidots applicationes suas creare et monetizare possunt — planis pretio fixo vel usu-fundato (per instrumentum, variabile vel nuntium) definitis, cyclis facturae et nummis multiplicibus.
              </p>
              <p class="lang-es">
                El módulo cubre el flujo completo: onboarding de Stripe, gestión de planes, administración de suscripciones y registro de pagos — todo dentro de la plataforma principal.
              </p>
              <p class="lang-en">
                The module covers the full flow: Stripe onboarding, plan management, subscription administration, and payment history — all within the main platform.
              </p>
              <p class="lang-lat">
                Modulus totum cursum tegit: inductionem Stripe, administrationem planorum, curationem subscriptionum et historiam solutionum — omnia intra suggestum principalem.
              </p>
              <a href="https://help.ubidots.com/en/articles/15033642-apps-monetize-your-apps-with-the-billing-module" target="_blank" rel="noopener" class="cs-doc-link">
                <span class="lang-es">Ver documentación oficial</span>
                <span class="lang-en">View official documentation</span>
                <span class="lang-lat">Vide documentationem officialem</span>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          </div>
          <div class="cs-screenshots-pair">
            <figure class="cs-screenshot">
              <Image src={stripe1} alt="Pantalla de onboarding de Stripe — conectar cuenta para monetizar apps con billing basado en uso" loading="lazy" />
            </figure>
            <figure class="cs-screenshot">
              <Image src={stripe2} alt="Editor de plan de billing mostrando configuración de precio por uso, ciclo de facturación y moneda" loading="lazy" />
              <figcaption class="lang-es">Gestión de planes — pricing usage-based por sensor</figcaption>
              <figcaption class="lang-en">Plan management — usage-based pricing per sensor</figcaption>
              <figcaption class="lang-lat">Administratio planorum — pretium pro usu per sensor</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <div class="cs-divider"></div>

      <!-- Module 2: ECharts / Line chart -->
      <section class="cs-section reveal">
        <div class="cs-section-label">
          <span class="lang-es">Módulo 02</span>
          <span class="lang-en">Module 02</span>
          <span class="lang-lat">Modulus 02</span>
        </div>
        <div class="cs-module cs-module--reverse">
          <div class="cs-module-text">
            <h2 class="cs-module-title">
              <span class="lang-es">Visualización de datos en tiempo real</span>
              <span class="lang-en">Real-time data visualization</span>
              <span class="lang-lat">Repraesentatio datorum in tempore reali</span>
            </h2>
            <div class="cs-prose">
              <p class="lang-es">
                Diseñé e implementé el sistema de anotaciones para los widgets de line chart: cada punto de la serie puede marcarse con una nota que referencia qué ocurrió en ese momento. El caso de uso principal es contextualizar gaps o anomalías en datos IoT — una máquina apagada, un mantenimiento programado, una lectura errónea — para que los reportes sean interpretables sin conocimiento previo del incidente.
              </p>
              <p class="lang-en">
                Designed and implemented the annotation system for line chart widgets: each point on the series can be marked with a note referencing what happened at that moment. The primary use case is contextualizing gaps or anomalies in IoT data — a powered-down machine, scheduled maintenance, a faulty reading — so reports are interpretable without prior knowledge of the incident.
              </p>
              <p class="lang-lat">
                Systema annotationum pro instrumentis lineae chartae designavi et exsecutioni dedi: quodlibet punctum seriei nota signari potest quae refert quid illo momento acciderit. Usus principalis est contextum dare lacunis vel anomaliis in datis IoT — machina extincta, conservatio ordinata, lectio erronea — ut relationes sine praevia scientia incidentis interpretari possint.
              </p>
              <p class="lang-es">
                Además, trabajo continuo en rendimiento sobre estos widgets: reducción de tiempos de render de 30s a menos de 15s mediante migración a TanStack Query para caching y manejo de estado.
              </p>
              <p class="lang-en">
                Additionally, ongoing performance work on these widgets: render time reduction from 30s to under 15s through migration to TanStack Query for caching and state management.
              </p>
              <p class="lang-lat">
                Praeterea, opus continuum de celeritate in his instrumentis: tempus reddendi a 30s ad minus quam 15s reductum per migrationem ad TanStack Query pro memoria antecedentium et administratione status.
              </p>
              <a href="https://help.ubidots.com/en/articles/2596623-line-chart-and-double-axis-widgets" target="_blank" rel="noopener" class="cs-doc-link">
                <span class="lang-es">Ver documentación oficial</span>
                <span class="lang-en">View official documentation</span>
                <span class="lang-lat">Vide documentationem officialem</span>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          </div>
          <figure class="cs-screenshot">
            <Image src={linechartAnnotations} alt="Widget de line chart mostrando series de temperatura y velocidad de viento con sistema de anotaciones" loading="lazy" />
            <figcaption class="lang-es">Line chart widget — múltiples series y anotaciones en tiempo real</figcaption>
            <figcaption class="lang-en">Line chart widget — multiple series and real-time annotations</figcaption>
            <figcaption class="lang-lat">Instrumentum lineae chartae — seriei multiplices et annotationes in tempore reali</figcaption>
          </figure>
        </div>
      </section>

      <div class="cs-divider"></div>

      <!-- Footer CTA -->
      <div class="cs-footer reveal">
        <a href="https://ubidots.com" target="_blank" rel="noopener" class="cs-cta">
          <span class="lang-es">Ver plataforma</span>
          <span class="lang-en">View platform</span>
          <span class="lang-lat">Vide suggestum</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href={`/${locale}/#experience`} class="cs-back">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span class="lang-es">Experiencia</span>
          <span class="lang-en">Experience</span>
          <span class="lang-lat">Experientia</span>
        </a>
      </div>

    </div>
  </main>
  <Lightbox />
  <Footer locale={locale} />
</Layout>

<style>
  .cs-main { padding-top: 64px; min-height: 100svh; }
  .cs-header { padding: 4rem 0 2.5rem; max-width: 720px; }
  .back-link { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.8rem; font-weight: 500; color: var(--text-2); margin-bottom: 2.5rem; transition: color 0.15s; }
  .back-link:hover { color: var(--text); }
  .cs-title-row { display: flex; align-items: baseline; gap: 1.25rem; margin-bottom: 1rem; }
  .cs-title { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; color: var(--text); letter-spacing: -0.03em; line-height: 1; }
  .cs-external { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.8rem; font-weight: 600; color: var(--text-3); border: 1px solid var(--border); padding: 3px 10px; border-radius: 100px; transition: color 0.15s, border-color 0.15s; }
  .cs-external:hover { color: var(--accent); border-color: var(--accent); }
  .cs-tagline { font-size: 1rem; color: var(--text-2); line-height: 1.7; margin-bottom: 1.25rem; }
  .cs-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .cs-tag { font-size: 0.68rem; padding: 2px 10px; background: var(--accent-dim); color: var(--accent-light); border-radius: 100px; font-weight: 600; letter-spacing: 0.04em; }
  .cs-disclaimer { font-size: 0.78rem; color: var(--text-3); font-style: italic; }
  .cs-divider { height: 1px; background: var(--border); }
  .cs-section { padding: 3.5rem 0; }
  .cs-section-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.75rem; }
  .cs-metrics { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--border); }
  .metric { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.75rem 2rem 1.75rem 0; border-right: 1px solid var(--border); }
  .metric:last-child { border-right: none; }
  .metric:not(:first-child) { padding-left: 2rem; }
  .metric-num { font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--accent); letter-spacing: -0.03em; line-height: 1; }
  .metric-label { font-size: 0.82rem; color: var(--text-2); line-height: 1.5; }
  .metric-sub { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.75rem; color: var(--text-3); }
  .cs-module { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start; }
  .cs-module--reverse { direction: rtl; }
  .cs-module--reverse > * { direction: ltr; }
  .cs-module-title { font-size: 1.4rem; font-weight: 700; color: var(--text); letter-spacing: -0.02em; margin-bottom: 1rem; }
  .cs-prose { display: flex; flex-direction: column; gap: 0.85rem; }
  .cs-prose p { font-size: 0.9rem; color: var(--text-2); line-height: 1.75; }
  .cs-doc-link { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; font-weight: 600; color: var(--accent); margin-top: 0.25rem; transition: opacity 0.2s; }
  .cs-doc-link:hover { opacity: 0.7; }
  .cs-screenshots-pair { display: flex; flex-direction: column; gap: 1rem; }
  .cs-screenshot { margin: 0; }
  .cs-screenshot img { width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); }
  .cs-screenshot figcaption { font-size: 0.75rem; color: var(--text-3); margin-top: 0.6rem; text-align: center; }
  .cs-footer { padding: 3.5rem 0 5rem; display: flex; align-items: center; gap: 2.5rem; }
  .cs-cta { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.875rem; font-weight: 700; color: var(--accent); border: 1px solid var(--accent); padding: 0.55rem 1.25rem; border-radius: 6px; transition: background 0.2s, color 0.2s; }
  .cs-cta:hover { background: var(--accent); color: #fff; }
  .cs-cta svg { transition: transform 0.2s; }
  .cs-cta:hover svg { transform: translateX(2px); }
  .cs-back { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; font-weight: 600; color: var(--text-2); transition: color 0.15s; }
  .cs-back:hover { color: var(--text); }
  @media (max-width: 860px) {
    .cs-module { grid-template-columns: 1fr; gap: 2rem; }
    .cs-module--reverse { direction: ltr; }
    .cs-metrics { grid-template-columns: 1fr; }
    .metric { border-right: none; border-bottom: 1px solid var(--border); padding: 1.25rem 0; }
    .metric:last-child { border-bottom: none; }
    .metric:not(:first-child) { padding-left: 0; }
  }
  @media (max-width: 600px) {
    .cs-title-row { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .cs-footer { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }
</style>
