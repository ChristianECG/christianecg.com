---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { talks, typeLabel } from '../../data/talks';
import '../../styles/global.css';

export function getStaticPaths() {
  return talks
    .filter((t) => t.slug && t.slides)
    .map((t) => ({ params: { slug: t.slug }, props: { talk: t } }));
}

const { talk } = Astro.props;
const label = typeLabel[talk.type];
---

<Layout
  title={`${talk.title_es} — Christian Elías Cruz González`}
  description={talk.title_en}
>
  <Nav />
  <main id="main-content" class="talk-main">
    <div class="container">

      <header class="talk-header reveal">
        <div class="talk-header-meta">
          <p class="section-eyebrow">
            <a href="/#talks" class="back-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
              </svg>
              <span class="lang-es">Charlas &amp; eventos</span>
              <span class="lang-en">Talks &amp; events</span>
            </a>
          </p>
          <div class="talk-meta-row">
            <span class={`talk-badge talk-badge--${talk.type}`}>
              <span class="lang-es">{label.es}</span>
              <span class="lang-en">{label.en}</span>
            </span>
            <span class="talk-date">
              <span class="lang-es">{talk.date_es}</span>
              <span class="lang-en">{talk.date_en}</span>
            </span>
          </div>
          <h1 class="talk-title">
            <span class="lang-es">{talk.title_es}</span>
            <span class="lang-en">{talk.title_en}</span>
          </h1>
          <p class="talk-event">
            <span class="lang-es">{talk.event_es} · {talk.format === 'online' ? 'Online' : 'Presencial'}</span>
            <span class="lang-en">{talk.event_en} · {talk.format === 'online' ? 'Online' : 'In person'}</span>
          </p>
        </div>

        <div class="talk-header-actions">
          <a href={talk.slides} download class="talk-btn talk-btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 3v13M5 16l7 7 7-7M3 21h18"/>
            </svg>
            <span class="lang-es">Descargar slides</span>
            <span class="lang-en">Download slides</span>
          </a>
        </div>
      </header>

      <div class="talk-embed reveal">
        <div class="frame-wrapper">
          <iframe
            src={talk.slides}
            class="talk-frame"
            title={talk.title_es}
          ></iframe>
          <div class="frame-overlay" id="frame-overlay" aria-hidden="true">
            <span class="frame-overlay-hint lang-es">Clic para interactuar</span>
            <span class="frame-overlay-hint lang-en">Click to interact</span>
          </div>
        </div>
        <p class="talk-fallback">
          <span class="lang-es">
            Tu navegador no puede mostrar el PDF directamente.
            <a href={talk.slides} download>Descárgalo aquí</a>.
          </span>
          <span class="lang-en">
            Your browser can't display the PDF inline.
            <a href={talk.slides} download>Download it here</a>.
          </span>
        </p>
      </div>

    </div>
  </main>
  <Footer />
<script>
  const overlay = document.getElementById('frame-overlay');
  overlay?.addEventListener('click', () => overlay.classList.add('is-active'));
  document.addEventListener('click', (e) => {
    if (overlay && !overlay.closest('.frame-wrapper')?.contains(e.target as Node)) {
      overlay.classList.remove('is-active');
    }
  });
</script>
</Layout>

<style>
  .talk-main {
    padding-top: 64px;
    min-height: 100svh;
  }

  .talk-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
    padding: 4rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .talk-header-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-3);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--text-2); }

  .talk-meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .talk-badge {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .talk-badge--keynote {
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid var(--accent-dim);
  }
  .talk-badge--talk {
    background: transparent;
    color: var(--text-3);
    border: 1px solid var(--border);
  }

  .talk-date {
    font-size: 0.76rem;
    color: var(--text-3);
    font-weight: 500;
  }

  .talk-title {
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1.2;
    max-width: 680px;
  }

  .talk-event {
    font-size: 0.875rem;
    color: var(--text-3);
    line-height: 1.5;
  }

  .talk-header-actions {
    flex-shrink: 0;
    padding-top: 2rem;
  }

  .talk-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.375rem;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s;
  }

  .talk-btn-primary {
    background: var(--accent-dim);
    border: 1px solid var(--border-hover);
    color: var(--accent-light);
  }
  .talk-btn-primary:hover {
    background: rgba(91, 140, 245, 0.2);
    border-color: var(--accent);
  }

  .talk-embed {
    padding: 2.5rem 0 5rem;
  }

  .frame-wrapper {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
  }

  .talk-frame {
    width: 100%;
    height: 85vh;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    display: block;
  }

  .frame-overlay {
    position: absolute;
    inset: 0;
    cursor: pointer;
    border-radius: 8px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 1.25rem;
    transition: opacity 0.2s;
  }
  .frame-overlay.is-active { display: none; }

  .frame-overlay-hint {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-3);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.3rem 0.75rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .frame-overlay:hover .frame-overlay-hint { opacity: 1; }

  .talk-fallback {
    display: none;
    font-size: 0.875rem;
    color: var(--text-2);
    margin-top: 1rem;
    text-align: center;
  }
  .talk-fallback a { color: var(--accent-light); }

  @media (max-width: 768px) {
    .talk-header {
      flex-direction: column;
      gap: 2rem;
    }
    .talk-header-actions { padding-top: 0; }
    .talk-frame { height: 65vh; }
    .talk-fallback { display: block; }
  }
</style>
