---
// Redirect /talks/[slug] → /es/talks/[slug]
import { talks } from '../../data/talks';

export function getStaticPaths() {
  return talks.filter((t) => t.slug && t.slides).map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
return Astro.redirect(`/es/talks/${slug}`, 301);
---
