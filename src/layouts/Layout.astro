---
import { ClientRouter } from 'astro:transitions';
import { useTranslations, getLocaleFromUrl } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  locale?: Locale;
}

const {
  title = 'Christian Elías Cruz González — Senior Software Engineer',
  description,
  ogType = 'website',
  ogImage = 'https://christianecg.com/og/default.png',
  jsonLd,
  locale: localeProp,
} = Astro.props;

const locale: Locale = localeProp ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const metaDescription = description || t('meta.description');

const base = 'https://christianecg.com';
const slug = Astro.url.pathname.replace(/^\/(es|en|lat)/, '');
const canonicalURL = new URL(Astro.url.pathname, base).href;
const hrefEs  = new URL(`/es${slug}`,  base).href;
const hrefEn  = new URL(`/en${slug}`,  base).href;

const ogLocale = locale === 'en' ? 'en_US' : 'es_MX';
const ogLocaleAlt = locale === 'en' ? 'es_MX' : 'en_US';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="author" content="Christian Elías Cruz González" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={hrefEs} />
    <link rel="alternate" hreflang="en" href={hrefEn} />
    <link rel="alternate" hreflang="x-default" href={hrefEs} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Christian Elías — Blog" href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title="Christian Elías — Blog (JSON)" href="/feed.json" />
    <link rel="search" type="application/opensearchdescription+xml" title="christianecg.com" href="/opensearch.xml" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/<\/script>/gi, '<\\/script>')} />}
    <script is:inline defer src="https://analytics.avelor.es/av.js" data-project="christianecg"></script>
    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <div class="noise-overlay" aria-hidden="true" transition:persist></div>
    <div class="cursor-glow" id="cursor-glow" aria-hidden="true" transition:persist></div>
    <a href="#main-content" class="skip-link">{t('layout.skip_to_content')}</a>
    <slot />
    <button class="back-to-top" id="back-to-top" aria-label={t('layout.back_to_top')}>↑</button>
    <script>
      // Console easter egg
      (function () {
        const accent = '#5B8CF5';
        const dim = '#3E4A60';
        const muted = '#7E8EAB';
        console.clear();
        console.log(
          '%c  cecg  ',
          `background:${accent};color:#fff;font-size:1.4rem;font-weight:800;letter-spacing:0.1em;padding:6px 18px;border-radius:4px`
        );
        console.log('%cchristianecg.com', `color:${muted};font-size:0.9rem;font-style:italic`);
        console.log(' ');
        console.log('%cSenior Software Engineer', `color:${accent};font-size:0.85rem;font-weight:600`);
        console.log('%cFrontend · Mobile · IoT', `color:${dim};font-size:0.75rem`);
        console.log(' ');
        console.log('%c↑ ↑ ↓ ↓ ← → ← → B A', `color:${muted};font-size:0.7rem;letter-spacing:0.05em`);
        console.log('%c(hay un secreto aquí)', `color:${dim};font-size:0.65rem;font-style:italic`);
      })();
    </script>
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(pointer: fine)').matches;
      let globalBound = false;

      // Re-runs on first load AND after every view transition
      function initPage() {
        // Scroll reveal — observe only not-yet-revealed elements
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -48px 0px' }
        );
        document.querySelectorAll('.reveal:not(.visible)').forEach((el) => observer.observe(el));

        // Back-to-top click (button is re-created per navigation, so re-bind here)
        const btt = document.getElementById('back-to-top') as HTMLButtonElement | null;
        btt?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

        // Cursor-tracking spotlight on cards/rows
        if (finePointer && !reduceMotion) {
          document.querySelectorAll<HTMLElement>('.spotlight').forEach((el) => {
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              el.style.setProperty('--mx', `${e.clientX - r.left}px`);
              el.style.setProperty('--my', `${e.clientY - r.top}px`);
            }, { passive: true });
          });
        }
      }

      // Global listeners — bound once, read live elements inside
      function bindGlobals() {
        if (globalBound) return;
        globalBound = true;

        window.addEventListener('scroll', () => {
          const bttEl = document.getElementById('back-to-top');
          bttEl?.classList.toggle('btt-visible', window.scrollY > 400);

          const scrollHint = document.getElementById('scroll-hint') as HTMLElement | null;
          if (scrollHint && window.scrollY > 60) scrollHint.style.opacity = '0';

          const navProgress = document.getElementById('nav-progress') as HTMLElement | null;
          if (navProgress) {
            const pct = window.scrollY / (document.body.scrollHeight - window.innerHeight);
            navProgress.style.width = (pct * 100) + '%';
          }
        }, { passive: true });

        // Cursor glow (element is transition:persist, so binds once)
        const glow = document.getElementById('cursor-glow') as HTMLElement | null;
        if (glow && finePointer) {
          document.addEventListener('mousemove', (e) => {
            glow.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
            glow.classList.add('visible');
          }, { passive: true });
          document.addEventListener('mouseleave', () => glow.classList.remove('visible'));
        }
      }

      // av.js only emits a pageview on full load and does not hook the History
      // API, so SPA navigations go uncounted. Re-send a pageview per navigation,
      // skipping the initial load that av.js already recorded.
      let avFirstLoad = true;
      function trackSpaPageview() {
        if (avFirstLoad) { avFirstLoad = false; return; }
        const host = location.hostname;
        if (host === 'localhost' || host === '127.0.0.1' || host === '::1') return;
        const project = document.querySelector('script[data-project]')?.getAttribute('data-project');
        if (!project) return;
        try {
          let s = sessionStorage.getItem('_av_sid');
          if (!s) {
            s = Date.now().toString(36) + Math.random().toString(36).slice(2);
            sessionStorage.setItem('_av_sid', s);
          }
          fetch('https://analytics.avelor.es/collect', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              project_id: project,
              url: location.pathname + (location.search || ''),
              referrer: document.referrer || null,
              session_id: s,
            }),
            keepalive: true,
            credentials: 'omit',
          }).catch(() => {});
        } catch (_) {}
      }

      document.addEventListener('astro:page-load', () => {
        bindGlobals();
        initPage();
        trackSpaPageview();
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 9999;
    background: var(--accent);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 0 0 6px 6px;
    text-decoration: none;
    transition: top 0.15s;
  }
  .skip-link:focus {
    top: 0;
    outline: none;
  }

  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 40px;
    height: 40px;
    background: rgba(25, 30, 45, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-2);
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 0.25s, transform 0.25s, border-color 0.2s, color 0.2s, box-shadow 0.25s;
    z-index: 90;
  }
  .back-to-top.btt-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .back-to-top:hover {
    border-color: var(--border-hover);
    color: var(--accent-light);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(91, 140, 245, 0.15);
  }
</style>
