---
const jobs = [
  {
    company: "Ubidots",
    url: "https://ubidots.com",
    role_es: "Ingeniero de Software Senior — Frontend & Mobile",
    role_en: "Senior Software Engineer — Frontend & Mobile",
    period: "Feb 2024 — May 2026",
    period_es: "Feb 2024 — May 2026",
    current: false,
    caseStudy: "/projects/ubidots",
    bullets_es: [
      "Contribuí a la arquitectura frontend de una plataforma IoT con +150K usuarios y millones de eventos en tiempo real.",
      "Diseñé el sistema de anotaciones para widgets de line chart — permite contextualizar gaps y anomalías en datos IoT directamente sobre la serie.",
      "Reduje tiempos de carga de dashboards de 8s → 5s (~37%) y optimicé widgets ECharts de 30s → <15s (~50%).",
      "Disminuí tiempos de despliegue de 50 min → 20 min (~60%) con mejoras en el pipeline de CI/CD.",
      "Implementé estándares de calidad con ESLint (plugin interno) para un equipo de +20 desarrolladores.",
      "Desarrollé el sistema de pagos y suscripciones de la plataforma.",
    ],
    bullets_en: [
      "Contributed to the frontend architecture of an IoT platform serving 150K+ users and millions of real-time events.",
      "Designed the annotation system for line chart widgets — allows contextualizing gaps and anomalies in IoT data directly on the series.",
      "Reduced dashboard load times from 8s → 5s (~37%) and optimized ECharts widgets from 30s → <15s (~50%).",
      "Cut deployment times from 50 min → 20 min (~60%) through CI/CD pipeline improvements.",
      "Implemented quality standards using ESLint (custom internal plugin) for a 20+ developer team.",
      "Built the platform's payments and subscriptions system from scratch.",
    ],
  },
  {
    company: "Ubidots",
    url: "https://ubidots.com",
    role_es: "Ingeniero Frontend Mid-Level",
    role_en: "Mid-level Frontend Engineer",
    period: "Jun 2022 — Feb 2024",
    period_es: "Jun 2022 — Feb 2024",
    current: false,
    bullets_es: [
      "Optimicé dashboards IoT migrando a TanStack Query para caching y manejo de estado.",
      "Mejoré rendimiento y UX en aplicaciones de alto volumen de datos.",
      "Implementé mejoras de accesibilidad, responsive design y consistencia visual.",
      "Trabajo con visualización avanzada (ECharts) en escenarios de datos intensivos.",
    ],
    bullets_en: [
      "Optimized IoT dashboards by migrating to TanStack Query for caching and state management.",
      "Improved performance and UX in high-volume data applications.",
      "Implemented accessibility improvements, responsive design, and visual consistency.",
      "Worked with advanced data visualization (ECharts) in data-intensive scenarios.",
    ],
  },
  {
    company: "Clever Cloud",
    url: "https://clevercloud.mx/",
    role_es: "Frontend Developer",
    role_en: "Frontend Developer",
    period: "Jul 2021 — Jun 2022",
    period_es: "Jul 2021 — Jun 2022",
    current: false,
    bullets_es: [
      "Desarrollé interfaces para +20 proyectos de clientes usando React, Vue y PHP.",
      "Gestioné de forma directa clientes propios, incluyendo Hola Buzz — desde el desarrollo inicial hasta soporte continuo.",
      "Implementé pipelines de CI/CD para mejorar los ciclos de despliegue.",
    ],
    bullets_en: [
      "Built interfaces for 20+ client projects using React, Vue, and PHP.",
      "Directly managed my own client accounts, including Hola Buzz — from initial development through ongoing support.",
      "Implemented CI/CD pipelines to improve deployment cycles.",
    ],
  },
  {
    company: "Google Developers",
    url: "https://developers.google.com/community/gdsc",
    role_es: "Developer Student Club Lead",
    role_en: "Developer Student Club Lead",
    period: "Ago 2020 — Jul 2021",
    period_es: "Ago 2020 — Jul 2021",
    current: false,
    bullets_es: [
      "Lideré una comunidad tecnológica estudiantil de +60 miembros.",
      "Organicé ~20 eventos técnicos: talleres, charlas y sesiones prácticas.",
      "Diseñé y desarrollé el sitio web de la comunidad.",
      "Participé como speaker y facilitador en eventos de desarrollo de software.",
    ],
    bullets_en: [
      "Led a student tech community of 60+ members.",
      "Organized ~20 technical events: workshops, talks, and hands-on sessions.",
      "Designed and built the community website.",
      "Participated as speaker and facilitator at software development events.",
    ],
  },
];
---

<section id="experience">
  <div class="container">
    <div class="exp-header reveal">
      <span class="section-eyebrow">
        <span class="lang-es">Experiencia</span>
        <span class="lang-en">Experience</span>
      </span>
      <h2 class="section-title">
        <span class="lang-es">Dónde he trabajado</span>
        <span class="lang-en">Where I've worked</span>
      </h2>
    </div>

    <div class="jobs">
      {jobs.map((job, i) => (
        <div class="job reveal" style={`--delay: ${i * 0.07}s`}>
          <div class="job-left">
            <span class="job-period lang-es">{job.period_es}</span>
            <span class="job-period lang-en">{job.period}</span>
            <a href={job.url} target="_blank" rel="noopener" class="job-company">
              {job.company}
            </a>
          </div>
          <div class="job-right">
            <div class="job-title-row">
              <h3 class="job-role">
                <span class="lang-es">{job.role_es}</span>
                <span class="lang-en">{job.role_en}</span>
              </h3>
              {job.current && (
                <span class="job-current">
                  <span class="lang-es">Actual</span>
                  <span class="lang-en">Current</span>
                </span>
              )}
            </div>
            <ul class="job-bullets">
              {job.bullets_es.map((b) => (
                <li class="lang-es">{b}</li>
              ))}
              {job.bullets_en.map((b) => (
                <li class="lang-en">{b}</li>
              ))}
            </ul>
            {job.caseStudy && (
              <a href={job.caseStudy} class="job-case-study">
                Case study
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .exp-header { margin-bottom: 0; }

  .jobs {
    display: flex;
    flex-direction: column;
  }

  .job {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    padding: 2.5rem 0 2.5rem 0.6rem;
    border-top: 1px solid var(--border);
    --delay: 0s;
    transition-delay: var(--delay);
    transition: background 0.25s, box-shadow 0.25s;
    border-radius: 4px;
  }
  .job:last-child { border-bottom: 1px solid var(--border); }
  .job:hover {
    background: rgba(91, 140, 245, 0.028);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .job-left {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.2rem;
  }

  .job-period {
    font-size: 0.78rem;
    color: var(--text-2);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .job-company {
    font-size: 0.82rem;
    color: var(--text-3);
    transition: color 0.2s;
    font-weight: 500;
  }
  .job-company:hover { color: var(--accent); }

  .job-case-study {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    transition: opacity 0.2s;
    margin-top: 0.25rem;
  }
  .job-case-study svg { transition: transform 0.2s; }
  .job-case-study:hover { opacity: 0.7; }
  .job-case-study:hover svg { transform: translateX(2px); }

  .job-right { display: flex; flex-direction: column; gap: 1rem; }

  .job-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .job-role {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .job-current {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    padding: 2px 8px;
    border-radius: 3px;
    background: var(--accent-dim);
    animation: badgePulse 2.8s ease-in-out infinite;
  }

  .job-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .job-bullets li {
    font-size: 0.88rem;
    color: var(--text-2);
    padding-left: 1rem;
    position: relative;
    line-height: 1.6;
  }
  .job-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-3);
    font-size: 0.78rem;
  }

  @media (max-width: 700px) {
    .job {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 2rem 0;
    }
    .job-left { flex-direction: row; align-items: center; gap: 1rem; flex-wrap: wrap; }
  }
</style>
