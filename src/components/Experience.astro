---
import { useTranslations, dataLang, pick } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const lang = dataLang(locale);

const jobs = [
  {
    company: "Ubidots",
    url: "https://ubidots.com",
    role_es: "Ingeniero de Software Senior — Frontend & Mobile",
    role_en: "Senior Software Engineer — Frontend & Mobile",
    role_lat: "Faber Programmatus Senior — Frontend & Mobile",
    period: "Feb 2024 — May 2026",
    current: false,
    caseStudy: "/projects/ubidots",
    bullets_es: [
      "Lideré arquitectura y performance de una plataforma IoT SaaS con más de 150K usuarios activos y datos en tiempo real vía WebSockets.",
      "Reduje tiempos de carga de dashboards de 8s → 5s (~37%) y optimicé rendering de widgets ECharts de 30s → <15s (~50%) mediante virtualización, memoization y canvas rendering.",
      "Acorté el ciclo de release de 50 a 20 min (~60%), reduciendo friction de entrega para un equipo de más de 20 desarrolladores.",
      "Establecí estándares de calidad, ESLint plugin interno y guías de code review adoptadas por todo el equipo; mentoreé a 2 ingenieros junior mediante pair programming y revisiones estructuradas.",
    ],
    bullets_en: [
      "Led architecture and performance of an IoT SaaS platform with 150K+ active users and real-time data via WebSockets.",
      "Reduced dashboard load times from 8s → 5s (~37%) and optimized ECharts widget rendering from 30s → <15s (~50%) through virtualization, memoization, and canvas rendering.",
      "Cut release cycle from 50 to 20 min (~60%), reducing delivery friction for a team of 20+ developers.",
      "Established quality standards, an internal ESLint plugin, and code review guidelines adopted by the whole team; mentored 2 junior engineers through pair programming and structured reviews.",
    ],
    bullets_lat: [
      "Architecturam et celeritatem suggestus IoT SaaS cum CL milibus utentium activis et data in tempore reali per WebSockets duxi.",
      "Tempora onerationis a 8s ad 5s (-37%) et redditum ECharts a 30s ad 15s (-50%) per virtualizationem et memoizationem minui.",
      "Cyclum editionis a 50 ad 20 min (-60%) contraxi; opus XX+ fabricatoribus leviorem feci.",
      "Normas qualitatis, pluginum ESLint internum et modos recensionis constitui; duos fabricatores iuniores per programmationem pari mentoravi.",
    ],
  },
  {
    company: "Ubidots",
    url: "https://ubidots.com",
    role_es: "Ingeniero Frontend Mid-Level",
    role_en: "Mid-level Frontend Engineer",
    role_lat: "Faber Frontend Medius",
    period: "Jun 2022 — Feb 2024",
    current: false,
    bullets_es: [
      "Implementé módulo de pagos con Stripe y migré el sistema de fetching a TanStack Query, eliminando estados duplicados y habilitando la conversión directa de freemium a pago.",
      "Construí y mantuve la app móvil (iOS + Android) en React Native, entregando nuevas funcionalidades de plataforma directamente a los usuarios finales.",
      "Participé en el diseño e implementación de componentes clave del sistema de dashboards IoT en tiempo real.",
    ],
    bullets_en: [
      "Implemented payments module with Stripe and migrated the fetching system to TanStack Query, eliminating duplicated state and enabling direct freemium-to-paid conversion.",
      "Built and maintained the mobile app (iOS + Android) in React Native, shipping new platform features directly to end users.",
      "Contributed to the design and implementation of key components of the real-time IoT dashboard system.",
    ],
    bullets_lat: [
      "Modulum solutionis pecuniariae cum Stripe institui et systema TanStack Query adoptavi, status duplicatos delens et conversionem directam freemium ad solutum agens.",
      "Applicationem mobilem (iOS + Android) in React Native construxi et sustinui, novas functiones utentibus tradidi.",
      "In consilio et exsecutione componentium dascifolii IoT in tempore reali participavi.",
    ],
  },
  {
    company: "Clever Cloud",
    url: "https://clevercloud.mx/",
    role_es: "Frontend Developer",
    role_en: "Frontend Developer",
    role_lat: "Fabricator Frontend",
    period: "Jul 2021 — Jun 2022",
    current: false,
    bullets_es: [
      "Desarrollé interfaces para +20 proyectos de clientes usando React, Vue y PHP.",
      "Gestioné de forma directa clientes propios, incluyendo Hola Buzz — desde el desarrollo inicial hasta soporte continuo.",
      "Implementé pipelines de CI/CD para mejorar los ciclos de despliegue.",
    ],
    bullets_en: [
      "Built interfaces for 20+ client projects using React, Vue, and PHP.",
      "Directly managed my own client accounts, including Hola Buzz — from initial development through ongoing support.",
      "Implemented CI/CD pipelines to improve deployment cycles.",
    ],
    bullets_lat: [
      "Interfacias pro XX+ operibus clientium in React, Vue et PHP construxi.",
      "Clientibus propriis, incluso Hola Buzz, directe praepositus fui — ab initio usque ad auxilium continuum.",
      "Vias CI/CD pro cyclis dispositionis meliorum statui, normam gregis factas.",
    ],
  },
  {
    company: "Google Developers",
    url: "https://developers.google.com/community/gdsc",
    role_es: "Developer Student Club Lead",
    role_en: "Developer Student Club Lead",
    role_lat: "Dux Collegii Studentium Fabricatorum",
    period: "Ago 2020 — Jul 2021",
    current: false,
    bullets_es: [
      "Lideré una comunidad tecnológica estudiantil de +60 miembros.",
      "Organicé ~20 eventos técnicos: talleres, charlas y sesiones prácticas.",
      "Diseñé y desarrollé el sitio web de la comunidad.",
      "Participé como speaker y facilitador en eventos de desarrollo de software.",
    ],
    bullets_en: [
      "Led a student tech community of 60+ members.",
      "Organized ~20 technical events: workshops, talks, and hands-on sessions.",
      "Designed and built the community website.",
      "Participated as speaker and facilitator at software development events.",
    ],
    bullets_lat: [
      "Communitatem technicam studentium LX+ membrorum duxi.",
      "XX eventus technicos institui: colloquia, sermones, sessiones practicas.",
      "Situm retis communitatis designavi et fabricavi.",
      "Orator et moderator in eventibus programmationis fui.",
    ],
  },
] as const;
---

<section id="experience">
  <div class="container">
    <div class="exp-header reveal">
      <span class="section-eyebrow">{t('experience.eyebrow')}</span>
      <h2 class="section-title">{t('experience.heading')}</h2>
    </div>

    <div class="jobs">
      {jobs.map((job, i) => (
        <div class="job reveal" style={`--delay: ${i * 0.07}s`}>
          <div class="job-left">
            <span class="job-period">{job.period}</span>
            <a href={job.url} target="_blank" rel="noopener" class="job-company">
              {job.company}
            </a>
          </div>
          <div class="job-right">
            <div class="job-title-row">
              <h3 class="job-role">{pick(job as any, 'role', lang)}</h3>
              {job.current && (
                <span class="job-current">{t('experience.current')}</span>
              )}
            </div>
            <ul class="job-bullets">
              {(pick(job as any, 'bullets', lang) as string[]).map((b: string) => (
                <li>{b}</li>
              ))}
            </ul>
            {'caseStudy' in job && job.caseStudy && (
              <a href={`/${locale}${job.caseStudy}`} class="job-case-study">
                {t('experience.case_study')}
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .exp-header { margin-bottom: 0; }

  .jobs {
    display: flex;
    flex-direction: column;
  }

  .job {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    padding: 2.5rem 0 2.5rem 0.6rem;
    border-top: 1px solid var(--border);
    --delay: 0s;
    transition-delay: var(--delay);
    transition: background 0.25s, box-shadow 0.25s;
    border-radius: 4px;
  }
  .job:last-child { border-bottom: 1px solid var(--border); }
  .job:hover {
    background: rgba(91, 140, 245, 0.028);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .job-left {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.2rem;
  }

  .job-period {
    font-size: 0.78rem;
    color: var(--text-2);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .job-company {
    font-size: 0.82rem;
    color: var(--text-3);
    transition: color 0.2s;
    font-weight: 500;
  }
  .job-company:hover { color: var(--accent); }

  .job-case-study {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    transition: opacity 0.2s;
    margin-top: 0.25rem;
  }
  .job-case-study svg { transition: transform 0.2s; }
  .job-case-study:hover { opacity: 0.7; }
  .job-case-study:hover svg { transform: translateX(2px); }

  .job-right { display: flex; flex-direction: column; gap: 1rem; }

  .job-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .job-role {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .job-current {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    padding: 2px 8px;
    border-radius: 3px;
    background: var(--accent-dim);
    animation: badgePulse 2.8s ease-in-out infinite;
  }

  .job-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .job-bullets li {
    font-size: 0.88rem;
    color: var(--text-2);
    padding-left: 1rem;
    position: relative;
    line-height: 1.6;
  }
  .job-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-3);
    font-size: 0.78rem;
  }

  @media (max-width: 700px) {
    .job {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 2rem 0;
    }
    .job-left { flex-direction: row; align-items: center; gap: 1rem; flex-wrap: wrap; }
  }
</style>
