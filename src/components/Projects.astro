---
import { Image } from 'astro:assets';
import { useTranslations, dataLang, pick } from '../i18n';
import type { Locale } from '../i18n';
import projectsData from '../data/projects.json';

// Project screenshots — keyed by the `slug` field in projects.json
import tuagendaShot from '../assets/projects/tuagenda.png';
import squawkShot from '../assets/projects/squawk.png';
import avelorShot from '../assets/projects/avelor.png';
import stratumShot from '../assets/projects/stratum.png';
import loftShot from '../assets/projects/loft.png';

const shots: Record<string, ImageMetadata> = {
  tuagenda: tuagendaShot,
  squawk: squawkShot,
  avelor: avelorShot,
  stratum: stratumShot,
  loft: loftShot,
};

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const lang = dataLang(locale);

const { projects } = projectsData;

const hostname = (url?: string) => {
  if (!url) return '';
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};
---

<section id="projects">
  <div class="container">
    <span class="section-eyebrow reveal">{t('projects.eyebrow')}</span>
    <h2 class="section-title reveal">{t('projects.heading')}</h2>

    {projects.length === 0 ? (
      <div class="projects-empty reveal">
        <div class="empty-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 7l9-4 9 4v10l-9 4-9-4V7z"/>
            <path d="M12 3v18M3 7l9 4 9-4"/>
          </svg>
        </div>
        <p class="empty-title">{t('projects.empty_title')}</p>
        <p class="empty-sub">{t('projects.empty_sub')}</p>
      </div>
    ) : (
      <div class="projects-list">
        {projects.map((project: any, i: number) => {
          const shot = shots[project.slug];
          const mediaHref = project.caseStudy ? `/${locale}${project.caseStudy}` : project.url;
          return (
            <article class="project-row spotlight reveal" style={`--delay: ${i * 0.08}s`}>
              <div class="project-content">
                <h3 class="project-title">{project.title}</h3>
                <div class="project-meta">
                  {project.tags?.map((tag: string) => (
                    <span class="project-tag">{tag}</span>
                  ))}
                </div>
                <p class="project-desc">
                  {pick(project, 'description', lang) as string}
                </p>
                <div class="project-links">
                  {project.caseStudy && (
                    <a href={`/${locale}${project.caseStudy}`} class="project-link">
                      {t('projects.case_study')}
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </a>
                  )}
                  {project.url && (
                    <a href={project.url} target="_blank" rel="noopener" class="project-link">
                      {project.caseStudy ? t('projects.view_site') : t('projects.view_project')}
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </a>
                  )}
                  {project.github && (
                    <a href={project.github} target="_blank" rel="noopener" class="project-link">
                      GitHub
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </a>
                  )}
                  {project.appStore && (
                    <a href={project.appStore} target="_blank" rel="noopener" class="project-link">
                      App Store
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </a>
                  )}
                  {project.playStore && (
                    <a href={project.playStore} target="_blank" rel="noopener" class="project-link">
                      Play Store
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>

              {shot && (
                <a
                  href={mediaHref}
                  target={project.caseStudy ? undefined : '_blank'}
                  rel={project.caseStudy ? undefined : 'noopener'}
                  class="project-media"
                  aria-label={`${project.title} — ${hostname(project.url)}`}
                >
                  <div class="browser-frame">
                    <div class="browser-bar">
                      <span class="browser-dots">
                        <i></i><i></i><i></i>
                      </span>
                      <span class="browser-url">{hostname(project.url)}</span>
                    </div>
                    <div class="browser-viewport">
                      <Image src={shot} alt={`${project.title} interface screenshot`} loading="lazy" widths={[400, 640, 900]} sizes="(max-width: 860px) 90vw, 460px" />
                    </div>
                  </div>
                </a>
              )}
            </article>
          );
        })}
      </div>
    )}
  </div>
</section>

<style>
  .projects-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
    background: var(--surface);
    border: 1px dashed var(--border-hover);
    border-radius: var(--radius);
    gap: 0.75rem;
  }

  .empty-icon { color: var(--text-3); margin-bottom: 0.5rem; }
  .empty-title { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--text-2); }
  .empty-sub { font-size: 0.875rem; color: var(--text-3); }

  .projects-list { display: flex; flex-direction: column; }

  .project-row {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 3.5rem;
    padding: 3rem 0;
    border-top: 1px solid var(--border);
    --delay: 0s;
    transition-delay: var(--delay);
    align-items: center;
    transition: background 0.25s;
    border-radius: 4px;
  }
  .project-row:last-child { border-bottom: 1px solid var(--border); }
  .project-row:hover { background: rgba(91, 140, 245, 0.028); }

  /* Alternate the media side for editorial rhythm */
  .project-row:nth-child(even) .project-content { order: 2; }
  .project-row:nth-child(even) .project-media { order: 1; }

  .project-content { display: flex; flex-direction: column; gap: 1rem; padding: 0 1.5rem; }
  .project-title { font-size: 1.3rem; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  .project-meta { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .project-tag { font-size: 0.68rem; padding: 2px 8px; background: var(--accent-dim); color: var(--accent-light); border-radius: 100px; font-weight: 600; letter-spacing: 0.04em; }
  .project-desc { font-size: 0.9rem; color: var(--text-2); line-height: 1.75; }
  .project-links { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 0.25rem; }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    transition: opacity 0.2s;
  }
  .project-link svg { transition: transform 0.2s; }
  .project-link:hover { opacity: 0.7; }
  .project-link:hover svg { transform: translateX(3px); }

  /* ── Browser-framed screenshot ── */
  .project-media {
    display: block;
    border-radius: 10px;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .project-media:hover { transform: translateY(-4px); }

  .browser-frame {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 12px 40px -16px rgba(0, 0, 0, 0.6);
    transition: border-color 0.3s, box-shadow 0.4s;
  }
  .project-media:hover .browser-frame {
    border-color: var(--border-hover);
    box-shadow: 0 22px 60px -20px rgba(0, 0, 0, 0.7);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 34px;
    padding: 0 0.85rem;
    background: #0d1019;
    border-bottom: 1px solid var(--border);
  }
  .browser-dots { display: flex; gap: 6px; flex-shrink: 0; }
  .browser-dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--surface-2); }
  .browser-dots i:nth-child(1) { background: #ff5f56; opacity: 0.55; }
  .browser-dots i:nth-child(2) { background: #ffbd2e; opacity: 0.55; }
  .browser-dots i:nth-child(3) { background: #27c93f; opacity: 0.55; }
  .browser-url {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-3);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .browser-viewport { background: var(--bg); }
  .browser-viewport img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }

  @media (max-width: 860px) {
    .project-row {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2.5rem 0;
    }
    .project-row:nth-child(even) .project-content { order: 2; }
    .project-row:nth-child(even) .project-media { order: 1; }
    .project-content { order: 2; padding: 0; }
    .project-media { order: 1; }
  }
</style>
