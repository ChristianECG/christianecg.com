---

<section class="hero">

  <div class="hero-topbar">
    <div class="container hero-topbar-inner">
      <div class="hero-label">
        <img src="/avatar.jpg" alt="Christian Elías" class="hero-avatar" loading="eager" />
        <span class="hero-role">
          <span class="lang-es">Ingeniero Frontend Senior</span>
          <span class="lang-en">Senior Frontend Engineer</span>
        </span>
      </div>
      <div class="hero-links">
        <a href="https://github.com/ChristianECG" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/christianeliascg/" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="mailto:contacto@christianecg.com">Email</a>
        <a href="/cv.pdf" download class="hero-link-cv">CV ↓</a>
      </div>
    </div>
  </div>

  <div class="hero-center">
    <div class="container">
      <h1 class="hero-name">Christian Elías<br />Cruz González</h1>
    </div>
  </div>

  <div class="hero-strip">
    <div class="container hero-strip-inner">
      <div class="hero-strip-left">
        <p class="hero-tagline">
          <span class="lang-es">
            150K usuarios usan mi código todos los días.<br />
            Ninguno sabe que existe. Ese es el punto.
          </span>
          <span class="lang-en">
            150K users run my code every day.<br />
            None of them know it exists. That's the point.
          </span>
        </p>
        <div class="hero-creds">
          <div class="cred">
            <span class="cred-label">IEEE Xplore</span>
            <span class="cred-detail lang-es">1 paper publicado</span>
            <span class="cred-detail lang-en">1 published paper</span>
          </div>
          <span class="cred-sep" aria-hidden="true">·</span>
          <div class="cred">
            <span class="cred-label">Keynote</span>
            <span class="cred-detail lang-es">3 congresos internacionales</span>
            <span class="cred-detail lang-en">3 international conferences</span>
          </div>
          <span class="cred-sep" aria-hidden="true">·</span>
          <div class="cred">
            <span class="cred-label lang-es">Televisión</span>
            <span class="cred-label lang-en">Television</span>
            <span class="cred-detail lang-es">2 apariciones nacionales</span>
            <span class="cred-detail lang-en">2 national appearances</span>
          </div>
        </div>
      </div>
      <div class="hero-ctas">
        <a href="#experience" class="cta-primary">
          <span class="lang-es">Ver experiencia</span>
          <span class="lang-en">See my work</span>
        </a>
        <a href="#contact" class="cta-ghost">
          <span class="lang-es">Contacto</span>
          <span class="lang-en">Contact</span>
        </a>
      </div>
    </div>
  </div>

</section>

<style>
  .hero {
    min-height: 100svh;
    padding-top: 64px;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--border);
  }

  /* Top bar */
  .hero-topbar {
    border-bottom: 1px solid var(--border);
  }

  .hero-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-hover);
  }

  .hero-role {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-2);
    letter-spacing: 0.02em;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
  }
  .hero-links a {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.2s;
  }
  .hero-links a:hover { color: var(--text); }
  .hero-link-cv {
    color: var(--accent) !important;
    font-weight: 600 !important;
  }
  .hero-link-cv:hover { opacity: 0.75; }

  /* Centered name */
  .hero-center {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .hero-name {
    font-size: clamp(3rem, 7.5vw, 7rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.0;
  }

  /* Bottom strip */
  .hero-strip {
    border-top: 1px solid var(--border);
  }

  .hero-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .hero-strip-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-tagline {
    font-size: clamp(0.82rem, 1.3vw, 0.95rem);
    color: var(--text-2);
    line-height: 1.75;
  }

  .hero-creds {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
  }

  .cred {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .cred-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .cred-detail {
    font-size: 0.78rem;
    color: var(--text-3);
    font-weight: 500;
  }

  .cred-sep {
    color: var(--text-3);
    font-size: 0.7rem;
    user-select: none;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .cta-primary {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--bg);
    background: var(--text);
    padding: 0.65rem 1.4rem;
    border-radius: 3px;
    transition: opacity 0.2s;
    letter-spacing: 0.01em;
  }
  .cta-primary:hover { opacity: 0.85; }

  .cta-ghost {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-2);
    padding: 0.65rem 1.4rem;
    border-radius: 3px;
    border: 1px solid var(--border-hover);
    transition: color 0.2s, border-color 0.2s;
  }
  .cta-ghost:hover {
    color: var(--text);
    border-color: var(--text-3);
  }

  @media (max-width: 800px) {
    .hero-name { font-size: clamp(2.5rem, 10vw, 4rem); }
    .hero-strip-inner { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  }

  @media (max-width: 500px) {
    .hero-links { display: none; }
  }
</style>
