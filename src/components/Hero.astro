---
import { Image } from 'astro:assets';
import avatarSrc from '../assets/avatar.png';
import { useTranslations, dataLang } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const lang = dataLang(locale);

const CV_URL = lang === 'en'
  ? '/Christian_Elias_Cruz_Gonzalez_eng.pdf'
  : '/Christian_Elias_Cruz_Gonzalez_esp.pdf';
---

<section class="hero" id="hero">

  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-orb" id="hero-orb"></div>
  </div>

  <div class="hero-center">
    <div class="container hero-center-inner">
      <div class="hero-name-block hero-enter-name">
        <h1 class="hero-name"><span class="text-gradient">Christian Elías<br />Cruz González</span></h1>
        <span class="hero-role">{t('hero.role')}</span>
      </div>
      <Image src={avatarSrc} alt="Christian Elías" class="hero-avatar hero-enter-avatar" loading="eager" width={200} height={200} />
    </div>
  </div>

  <div class="hero-strip">
    <div class="container hero-strip-inner">
      <div class="hero-strip-left">
        <p class="hero-tagline">
          {t('hero.tagline_1')}<br />
          {t('hero.tagline_2')}
        </p>
        <p class="hero-location">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          {t('hero.location')}
        </p>
        <div class="hero-creds">
          <div class="cred">
            <svg class="cred-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            <span class="cred-label">IEEE Xplore</span>
            <span class="cred-detail">{t('hero.cred_ieee')}</span>
          </div>
          <div class="cred">
            <svg class="cred-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
            <span class="cred-label">Keynote</span>
            <span class="cred-detail">{t('hero.cred_keynote')}</span>
          </div>
          <div class="cred">
            <svg class="cred-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="15" rx="2"/><polyline points="17 2 12 7 7 2"/></svg>
            <span class="cred-label">{t('hero.cred_tv_label')}</span>
            <span class="cred-detail">{t('hero.cred_tv_detail')}</span>
          </div>
        </div>
      </div>
      <div class="hero-strip-right">
        <div class="hero-links">
          <a href="https://github.com/ChristianECG" target="_blank" rel="noopener">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/christianeliascg/" target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href="mailto:contacto@christianecg.com">Email</a>
          <a href={CV_URL} download class="hero-link-cv" data-cv-download>CV ↓</a>
        </div>
        <div class="hero-ctas">
          <a href="#experience" class="cta-primary">{t('hero.cta_experience')}</a>
          <a href="#contact" class="cta-ghost">{t('hero.cta_contact')}</a>
        </div>
      </div>
    </div>
  </div>

  <div class="scroll-hint" id="scroll-hint" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </div>

</section>

<style>
  .hero {
    min-height: 100svh;
    padding-top: 64px;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
    background: radial-gradient(ellipse 85% 50% at 0% 0%, rgba(91, 140, 245, 0.06) 0%, transparent 55%);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* Dot grid with a soft radial mask that fades toward edges */
  .hero-grid {
    position: absolute;
    inset: -10%;
    background-image: radial-gradient(rgba(100, 140, 220, 0.16) 1px, transparent 1px);
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 42%, #000 0%, transparent 78%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 42%, #000 0%, transparent 78%);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* Glow orb that follows the cursor with parallax */
  .hero-orb {
    position: absolute;
    top: 38%;
    left: 50%;
    width: 540px;
    height: 540px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(91, 140, 245, 0.13) 0%, rgba(70, 224, 190, 0.05) 40%, transparent 68%);
    translate: -50% -50%;
    filter: blur(8px);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .scroll-hint {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    translate: -50% 0;
    color: var(--text-3);
    opacity: 0;
    animation: scrollHintIn 0.5s ease 1.9s both, scrollBounce 2s ease-in-out 2.5s infinite;
    pointer-events: none;
    transition: opacity 0.4s;
    z-index: 1;
  }

  .hero-avatar {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-hover);
    flex-shrink: 0;
    transition: box-shadow 0.35s ease, filter 0.35s ease;
  }
  .hero-avatar:hover {
    box-shadow: 0 0 0 3px rgba(91, 140, 245, 0.3), 0 0 0 5px rgba(91, 140, 245, 0.08), 0 14px 40px rgba(0, 0, 0, 0.45);
    filter: brightness(1.07);
  }

  .hero-role {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-2);
    letter-spacing: 0.02em;
  }
  .hero-role::before {
    content: '/ ';
    color: var(--accent);
    font-weight: 400;
    opacity: 0.75;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
  }
  .hero-links a {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.2s;
  }
  .hero-links a:hover { color: var(--text); }
  .hero-link-cv {
    color: var(--accent) !important;
    font-weight: 600 !important;
  }
  .hero-link-cv:hover { opacity: 0.75; }

  .hero-center {
    flex: 1;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-center-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6rem;
  }

  .hero-name-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-name {
    font-size: clamp(2.75rem, 6vw, 6rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.0;
    cursor: default;
  }

  .hero-enter-name {
    animation: heroIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
  }
  .hero-enter-avatar {
    animation: heroScale 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.28s both;
  }
  .hero-strip {
    animation: heroIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.45s both;
  }

  .hero-strip {
    position: relative;
    z-index: 1;
  }

  .hero-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .hero-strip-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-tagline {
    font-size: clamp(0.82rem, 1.3vw, 0.95rem);
    color: var(--text-2);
    line-height: 1.75;
  }

  .hero-location {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    color: var(--text-3);
    font-weight: 500;
  }
  .hero-location svg {
    flex-shrink: 0;
    opacity: 0.6;
  }

  .hero-creds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }

  .cred {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.7rem;
    background: rgba(25, 30, 45, 0.5);
    border: 1px solid var(--border);
    border-radius: 100px;
    transition: border-color 0.22s, transform 0.22s, background 0.22s;
  }
  .cred:hover {
    border-color: rgba(91, 140, 245, 0.32);
    background: var(--accent-dim);
    transform: translateY(-2px);
  }

  .cred-icon {
    color: var(--accent);
    flex-shrink: 0;
  }

  .cred-label {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--accent-light);
  }

  .cred-detail {
    font-size: 0.74rem;
    color: var(--text-2);
    font-weight: 500;
  }

  .hero-strip-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cta-primary {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--bg);
    background: var(--text);
    padding: 0.65rem 1.4rem;
    border-radius: 3px;
    transition: opacity 0.2s, transform 0.1s linear;
    letter-spacing: 0.01em;
    will-change: transform;
    display: inline-block;
  }
  .cta-primary:hover { opacity: 0.85; }

  .cta-ghost {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-2);
    padding: 0.65rem 1.4rem;
    border-radius: 3px;
    border: 1px solid var(--border-hover);
    transition: color 0.2s, border-color 0.2s, transform 0.1s linear;
    will-change: transform;
    display: inline-block;
  }
  .cta-ghost:hover {
    color: var(--text);
    border-color: var(--text-3);
  }

  .hero-creds .cred:nth-child(1) { animation: credIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) 1.05s both; }
  .hero-creds .cred:nth-child(2) { animation: credIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) 1.18s both; }
  .hero-creds .cred:nth-child(3) { animation: credIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) 1.31s both; }

  @media (max-width: 800px) {
    .hero-name { font-size: clamp(2.5rem, 10vw, 4rem); }
    .hero-center-inner { flex-direction: column; align-items: center; gap: 1.5rem; }
    .hero-name-block { align-items: center; text-align: center; }
    .hero-strip-inner { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .hero-strip-right { align-items: flex-start; }
  }

</style>

<script>
  const heroReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const heroFine = window.matchMedia('(pointer: fine)').matches;
  let heroParallaxBound = false;

  function initHero() {
    // Magnetic CTAs (elements are recreated on view-transition back to home)
    if (!heroReduce) {
      document.querySelectorAll<HTMLElement>('.cta-primary, .cta-ghost').forEach((btn) => {
        btn.addEventListener('mousemove', (e) => {
          btn.style.transition = 'opacity 0.2s, transform 0.1s linear';
          const r = btn.getBoundingClientRect();
          const dx = (e.clientX - (r.left + r.width / 2)) * 0.3;
          const dy = (e.clientY - (r.top + r.height / 2)) * 0.3;
          btn.style.transform = `translate(${dx}px, ${dy}px)`;
        }, { passive: true });
        btn.addEventListener('mouseleave', () => {
          btn.style.transition = 'opacity 0.2s, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
          btn.style.transform = '';
        });
      });
    }

    document.querySelector<HTMLAnchorElement>('[data-cv-download]')?.addEventListener('click', (e) => {
      const link = e.currentTarget as HTMLAnchorElement;
      (window as any).avelor?.track('cv_download', { url: link.href });
    });

    // Reactive parallax background (bound once on document, reads live nodes)
    if (heroFine && !heroReduce && !heroParallaxBound) {
      heroParallaxBound = true;
      document.addEventListener('mousemove', (e) => {
        // Hero is the first full-viewport section; skip once scrolled past it
        if (window.scrollY > window.innerHeight) return;
        const orb = document.getElementById('hero-orb');
        if (!orb) return;
        const grid = document.querySelector<HTMLElement>('.hero-grid');
        const nx = (e.clientX / window.innerWidth - 0.5);
        const ny = (e.clientY / window.innerHeight - 0.5);
        orb.style.transform = `translate(${nx * 60}px, ${ny * 60}px)`;
        if (grid) grid.style.transform = `translate(${nx * -18}px, ${ny * -18}px)`;
      }, { passive: true });
    }
  }

  document.addEventListener('astro:page-load', initHero);
</script>
