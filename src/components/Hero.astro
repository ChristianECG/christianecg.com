---
import { Image } from 'astro:assets';
import HeroCanvas from './HeroCanvas.astro';
import avatarSrc from '../assets/avatar.png';
---

<section class="hero">
  <div class="hero-blobs" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
  </div>
  <HeroCanvas />

  <div class="hero-center">
    <div class="container hero-center-inner">
      <div class="hero-name-block hero-enter-name">
        <h1 class="hero-name">Christian Elías<br />Cruz González</h1>
        <span class="hero-role">
          <span class="lang-es">Ingeniero de Software Senior</span>
          <span class="lang-en">Senior Software Engineer</span>
        </span>
      </div>
      <Image src={avatarSrc} alt="Christian Elías" class="hero-avatar hero-enter-avatar" loading="eager" width={200} height={200} />
    </div>
  </div>

  <div class="hero-strip">
    <div class="container hero-strip-inner">
      <div class="hero-strip-left">
        <p class="hero-tagline">
          <span class="lang-es">
            150K usuarios usan mi código todos los días.<br />
            Ninguno sabe que existe. Ese es el punto.
          </span>
          <span class="lang-en">
            150K users run my code every day.<br />
            None of them know it exists. That's the point.
          </span>
        </p>
        <div class="hero-creds">
          <div class="cred">
            <span class="cred-label">IEEE Xplore</span>
            <span class="cred-detail lang-es">1 paper publicado</span>
            <span class="cred-detail lang-en">1 published paper</span>
          </div>
          <div class="cred">
            <span class="cred-label">Keynote</span>
            <span class="cred-detail lang-es">3 congresos internacionales</span>
            <span class="cred-detail lang-en">3 international conferences</span>
          </div>
          <div class="cred">
            <span class="cred-label lang-es">Televisión</span>
            <span class="cred-label lang-en">Television</span>
            <span class="cred-detail lang-es">2 apariciones nacionales</span>
            <span class="cred-detail lang-en">2 national appearances</span>
          </div>
        </div>
      </div>
      <div class="hero-strip-right">
        <div class="hero-links">
          <a href="https://github.com/ChristianECG" target="_blank" rel="noopener">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/christianeliascg/" target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href="mailto:contacto@christianecg.com">Email</a>
          <a href="/Christian_Elias_Cruz_Gonzalez_esp.pdf" download class="hero-link-cv" data-cv-download>CV ↓</a>
        </div>
        <div class="hero-ctas">
          <a href="#experience" class="cta-primary">
            <span class="lang-es">Ver experiencia</span>
            <span class="lang-en">See my work</span>
          </a>
          <a href="#contact" class="cta-ghost">
            <span class="lang-es">Contacto</span>
            <span class="lang-en">Contact</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="scroll-hint" id="scroll-hint" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </div>

</section>

<style>
  .hero {
    min-height: 100svh;
    padding-top: 64px;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .scroll-hint {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    translate: -50% 0;
    color: var(--text-3);
    opacity: 0;
    animation: scrollHintIn 0.5s ease 1.9s both, scrollBounce 2s ease-in-out 2.5s infinite;
    pointer-events: none;
    transition: opacity 0.4s;
    z-index: 1;
  }

  .hero-avatar {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-hover);
    flex-shrink: 0;
    transition: box-shadow 0.35s ease, filter 0.35s ease;
  }
  .hero-avatar:hover {
    box-shadow: 0 0 0 3px rgba(91, 140, 245, 0.3), 0 0 0 5px rgba(91, 140, 245, 0.08), 0 14px 40px rgba(0, 0, 0, 0.45);
    filter: brightness(1.07);
  }

  .hero-role {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-2);
    letter-spacing: 0.02em;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
  }
  .hero-links a {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.2s;
  }
  .hero-links a:hover { color: var(--text); }
  .hero-link-cv {
    color: var(--accent) !important;
    font-weight: 600 !important;
  }
  .hero-link-cv:hover { opacity: 0.75; }

  /* Centered name */
  .hero-center {
    flex: 1;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-center-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6rem;
  }

  .hero-name-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-name {
    font-size: clamp(2.75rem, 6vw, 6rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.0;
    cursor: default;
    transition: text-shadow 0.45s ease;
  }
  .hero-name:hover {
    text-shadow:
      0 0 18px rgba(91, 140, 245, 0.55),
      0 0 55px rgba(91, 140, 245, 0.28),
      0 0 110px rgba(91, 140, 245, 0.13);
  }

  /* Entrance animations */
  .hero-enter-name {
    animation: heroIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
  }
  .hero-enter-avatar {
    animation: heroScale 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.28s both;
  }
  .hero-strip {
    animation: heroIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.45s both;
  }

  /* Bottom strip */
  .hero-strip {
    position: relative;
    z-index: 1;
  }

  .hero-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .hero-strip-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-tagline {
    font-size: clamp(0.82rem, 1.3vw, 0.95rem);
    color: var(--text-2);
    line-height: 1.75;
  }

  .hero-creds {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .cred {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .cred-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .cred-detail {
    font-size: 0.78rem;
    color: var(--text-3);
    font-weight: 500;
  }

.hero-strip-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cta-primary {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--bg);
    background: var(--text);
    padding: 0.65rem 1.4rem;
    border-radius: 3px;
    transition: opacity 0.2s, transform 0.1s linear;
    letter-spacing: 0.01em;
    will-change: transform;
    display: inline-block;
  }
  .cta-primary:hover { opacity: 0.85; }

  .cta-ghost {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-2);
    padding: 0.65rem 1.4rem;
    border-radius: 3px;
    border: 1px solid var(--border-hover);
    transition: color 0.2s, border-color 0.2s, transform 0.1s linear;
    will-change: transform;
    display: inline-block;
  }
  .cta-ghost:hover {
    color: var(--text);
    border-color: var(--text-3);
  }

  /* Cred stagger — fire after strip entrance (~1.05s) */
  .hero-creds .cred:nth-child(1) { animation: credIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) 1.05s both; }
  .hero-creds .cred:nth-child(2) { animation: credIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) 1.18s both; }
  .hero-creds .cred:nth-child(3) { animation: credIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) 1.31s both; }

  @media (max-width: 800px) {
    .hero-name { font-size: clamp(2.5rem, 10vw, 4rem); }
    .hero-center-inner { flex-direction: column; align-items: center; gap: 1.5rem; }
    .hero-name-block { align-items: center; text-align: center; }
    .hero-strip-inner { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .hero-strip-right { align-items: flex-start; }
  }

  .type-cursor {
    display: inline-block;
    margin-left: 2px;
    color: var(--accent);
    font-weight: 300;
    animation: cursorBlink 0.75s step-end infinite;
    transition: opacity 0.5s;
  }

  /* Aurora blobs */
  .hero-blobs {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .blob-1 {
    width: 640px;
    height: 640px;
    background: #5B8CF5;
    filter: blur(120px);
    opacity: 0.13;
    top: -160px;
    left: -180px;
    animation: blobFloat1 16s ease-in-out infinite;
  }

  .blob-2 {
    width: 520px;
    height: 520px;
    background: #7C5CF5;
    filter: blur(110px);
    opacity: 0.10;
    top: 20%;
    right: -120px;
    animation: blobFloat2 19s ease-in-out infinite;
  }

  .blob-3 {
    width: 480px;
    height: 480px;
    background: #3A8EF5;
    filter: blur(130px);
    opacity: 0.09;
    bottom: -100px;
    left: 35%;
    animation: blobFloat3 22s ease-in-out infinite;
  }

  @keyframes blobFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(55px, 45px) scale(1.06); }
    66%       { transform: translate(-25px, 65px) scale(0.96); }
  }

  @keyframes blobFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40%       { transform: translate(-55px, -65px) scale(1.09); }
    70%       { transform: translate(45px, 35px) scale(0.94); }
  }

  @keyframes blobFloat3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    30%       { transform: translate(-45px, -55px) scale(1.04); }
    65%       { transform: translate(75px, -35px) scale(0.97); }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob { animation: none; }
  }

  @media (max-width: 768px) {
    .blob-1 { width: 380px; height: 380px; }
    .blob-2 { width: 300px; height: 300px; }
    .blob-3 { width: 280px; height: 280px; }
  }
</style>

<script>
  // CV link: swap URL on lang change
  const CV_URLS: Record<string, string> = {
    es: '/Christian_Elias_Cruz_Gonzalez_esp.pdf',
    en: '/Christian_Elias_Cruz_Gonzalez_eng.pdf',
  };
  const cvLink = document.querySelector<HTMLAnchorElement>('.hero-link-cv');
  if (cvLink) {
    const syncCvLang = () => {
      const lang = document.documentElement.lang || 'es';
      cvLink.href = CV_URLS[lang] ?? CV_URLS.es;
    };
    syncCvLang();
    new MutationObserver(syncCvLang).observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
    cvLink.addEventListener('click', () => {
      window.avelor?.track('cv_download', { url: cvLink.href });
    });
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.cta-primary, .cta-ghost').forEach((btn) => {
      btn.addEventListener('mousemove', (e) => {
        btn.style.transition = 'opacity 0.2s, transform 0.1s linear';
        const r = btn.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width / 2)) * 0.3;
        const dy = (e.clientY - (r.top + r.height / 2)) * 0.3;
        btn.style.transform = `translate(${dx}px, ${dy}px)`;
      }, { passive: true });
      btn.addEventListener('mouseleave', () => {
        btn.style.transition = 'opacity 0.2s, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
        btn.style.transform = '';
      });
    });
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const roleEl = document.querySelector<HTMLElement>('.hero-role');
    const lang = document.documentElement.lang || 'es';
    const span = roleEl?.querySelector<HTMLElement>(`.lang-${lang}`);
    if (span) {
      const full = span.textContent?.trim() ?? '';
      span.textContent = '';
      const cursor = document.createElement('span');
      cursor.className = 'type-cursor';
      cursor.textContent = '|';
      roleEl!.appendChild(cursor);
      let i = 0;
      const type = () => {
        if (i < full.length) {
          span.textContent += full[i++];
          setTimeout(type, 42);
        } else {
          setTimeout(() => { cursor.style.opacity = '0'; }, 1500);
        }
      };
      setTimeout(type, 950);
    }
  }
</script>
