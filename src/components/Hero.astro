---
---

<section class="hero">
  <div class="container">

    <div class="hero-top">
      <div class="hero-label">
        <img src="/avatar.jpg" alt="Christian Elías" class="hero-avatar" loading="eager" />
        <span class="hero-role">
          <span class="lang-es">Ingeniero Frontend Senior</span>
          <span class="lang-en">Senior Frontend Engineer</span>
        </span>
      </div>
      <div class="hero-links">
        <a href="https://github.com/ChristianECG" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/christianeliascg/" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="mailto:contacto@christianecg.com">Email</a>
        <a href="/cv.pdf" download class="hero-link-cv">
          <span class="lang-es">CV ↓</span>
          <span class="lang-en">CV ↓</span>
        </a>
      </div>
    </div>

    <h1 class="hero-name">Christian Elías<br />Cruz González</h1>

    <div class="hero-bottom-row">
      <p class="hero-tagline">
        <span class="lang-es">
          150K usuarios usan mi código todos los días.<br />
          Ninguno sabe que existe. Ese es el punto.
        </span>
        <span class="lang-en">
          150K users run my code every day.<br />
          None of them know it exists. That's the point.
        </span>
      </p>

      <div class="hero-ctas">
        <a href="#experience" class="cta-primary">
          <span class="lang-es">Ver experiencia</span>
          <span class="lang-en">See my work</span>
        </a>
        <a href="#contact" class="cta-ghost">
          <span class="lang-es">Contacto</span>
          <span class="lang-en">Contact</span>
        </a>
      </div>
    </div>

  </div>

  <div class="hero-creds">
    <div class="container hero-creds-inner">
      <div class="cred">
        <span class="cred-label">IEEE Xplore</span>
        <span class="cred-detail lang-es">1 paper publicado</span>
        <span class="cred-detail lang-en">1 published paper</span>
      </div>
      <span class="cred-sep" aria-hidden="true">·</span>
      <div class="cred">
        <span class="cred-label">Keynote</span>
        <span class="cred-detail lang-es">3 congresos internacionales</span>
        <span class="cred-detail lang-en">3 international conferences</span>
      </div>
      <span class="cred-sep" aria-hidden="true">·</span>
      <div class="cred">
        <span class="cred-label lang-es">Televisión</span>
        <span class="cred-label lang-en">Television</span>
        <span class="cred-detail lang-es">2 apariciones nacionales</span>
        <span class="cred-detail lang-en">2 national appearances</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 64px;
    border-bottom: 1px solid var(--border);
  }

  .container { padding-top: 3rem; }

  .hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-hover);
  }

  .hero-role {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-2);
    letter-spacing: 0.02em;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
  }
  .hero-links a {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.2s;
  }
  .hero-links a:hover { color: var(--text); }

  .hero-link-cv {
    color: var(--accent) !important;
    font-weight: 600 !important;
  }
  .hero-link-cv:hover { opacity: 0.75; }

  .hero-name {
    font-size: clamp(3rem, 7.5vw, 7rem);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1.0;
    margin-bottom: 3rem;
  }

  .hero-bottom-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 3.5rem;
  }

  .hero-tagline {
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: var(--text-2);
    line-height: 1.75;
    max-width: 440px;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .cta-primary {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--bg);
    background: var(--text);
    padding: 0.65rem 1.4rem;
    border-radius: 3px;
    transition: opacity 0.2s;
    letter-spacing: 0.01em;
  }
  .cta-primary:hover { opacity: 0.85; }

  .cta-ghost {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-2);
    transition: color 0.2s;
  }
  .cta-ghost:hover { color: var(--text); }

  /* Credentials strip */
  .hero-creds {
    border-top: 1px solid var(--border);
  }

  .hero-creds-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    padding-top: 0 !important;
    padding-bottom: 0;
  }

  .cred {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 1.4rem 0;
  }

  .cred-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .cred-detail {
    font-size: 0.82rem;
    color: var(--text-2);
    font-weight: 500;
  }

  .cred-sep {
    color: var(--text-3);
    font-size: 0.75rem;
    user-select: none;
    flex-shrink: 0;
  }

  @media (max-width: 800px) {
    .hero-bottom-row { flex-direction: column; align-items: flex-start; }
    .hero-name { font-size: clamp(2.5rem, 10vw, 4rem); margin-bottom: 2rem; }
  }

  @media (max-width: 640px) {
    .cred-sep { display: none; }
    .hero-creds-inner { flex-direction: column; align-items: flex-start; gap: 0; }
    .cred {
      padding: 0.9rem 0;
      border-top: 1px solid var(--border);
      width: 100%;
    }
    .cred:last-of-type { border-bottom: 1px solid var(--border); }
  }

  @media (max-width: 500px) {
    .hero-top { flex-wrap: wrap; gap: 1rem; }
    .hero-links { display: none; }
  }
</style>
