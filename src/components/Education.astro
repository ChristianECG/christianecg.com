---
import { useTranslations, dataLang } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const lang = dataLang(locale);

const degrees = [
  {
    type: "degree",
    degree_es: "Ingeniería en Tecnologías de la Información y Comunicaciones",
    degree_en: "B.Eng. in Information and Communication Technologies",
    institution: "Instituto Tecnológico Superior del Occidente del Estado de Hidalgo",
    institution_short: "ITSOEH",
    period: "2018 — 2022",
    location_es: "Hidalgo, México",
    location_en: "Hidalgo, Mexico",
    selective_note_es: null as string | null,
    selective_note_en: null as string | null,
    highlight_es: "Publicación en IEEE Xplore sobre seguridad en sistemas blockchain descentralizados.",
    highlight_en: "Published research in IEEE Xplore on security in decentralized blockchain systems.",
    bullets_es: null as string[] | null,
    bullets_en: null as string[] | null,
    links: null as { label: string; url: string }[] | null,
  },
  {
    type: "program",
    degree_es: "Platzi Master Program · Cohorte 8",
    degree_en: "Platzi Master Program · Cohort 8",
    institution: "Platzi",
    institution_short: "Platzi",
    period: "Oct 2021 — Mar 2022",
    location_es: null as string | null,
    location_en: null as string | null,
    selective_note_es: "Admisión por proceso de selección",
    selective_note_en: "Admission by selection process",
    highlight_es: null as string | null,
    highlight_en: null as string | null,
    bullets_es: [
      "Retos técnicos semanales de JavaScript y React con pair programming y feedback estructurado.",
      "Comunidad GetHired: colaboración con desarrolladores de toda Latinoamérica en preparación para procesos de selección en la industria.",
    ],
    bullets_en: [
      "Weekly JavaScript and React challenges with pair programming and structured feedback.",
      "GetHired community: collaborated with developers across Latin America on industry hiring preparation.",
    ],
    links: [
      { label: "GetHired — GitHub", url: "https://github.com/Platzi-Master-C8/gethired-community" },
    ],
  },
];
---

<section id="education">
  <div class="container">
    <div class="edu-header reveal">
      <span class="section-eyebrow">{t('education.eyebrow')}</span>
      <h2 class="section-title">{t('education.heading')}</h2>
    </div>

    <div class="degrees">
      {degrees.map((d, i) => (
        <div class="degree reveal" style={`--delay: ${i * 0.07}s`}>
          <div class="degree-left">
            <span class="degree-period">{d.period}</span>
            <span class="degree-institution" title={d.institution}>{d.institution_short}</span>
            {(d.location_es || d.location_en) && (
              <span class="degree-location">
                {lang === 'en' ? d.location_en : d.location_es}
              </span>
            )}
          </div>
          <div class="degree-right">
            <h3 class="degree-title">
              {lang === 'en' ? d.degree_en : d.degree_es}
            </h3>
            {(d.selective_note_es || d.selective_note_en) && (
              <p class="degree-selective-note">
                {lang === 'en' ? d.selective_note_en : d.selective_note_es}
              </p>
            )}
            {(d.highlight_es || d.highlight_en) && (
              <p class="degree-highlight">
                {lang === 'en' ? d.highlight_en : d.highlight_es}
              </p>
            )}
            {d.bullets_es && (
              <ul class="degree-bullets">
                {(lang === 'en' ? d.bullets_en! : d.bullets_es).map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
            {d.links && (
              <div class="degree-links">
                {d.links.map((l) => (
                  <a href={l.url} target="_blank" rel="noopener" class="degree-link">
                    {l.label}
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .edu-header { margin-bottom: 0; }

  .degrees {
    display: flex;
    flex-direction: column;
  }

  .degree {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    padding: 2.5rem 0 2.5rem 0.6rem;
    border-top: 1px solid var(--border);
    --delay: 0s;
    transition-delay: var(--delay);
    transition: background 0.25s, box-shadow 0.25s;
    border-radius: 4px;
  }
  .degree:last-child { border-bottom: 1px solid var(--border); }
  .degree:hover {
    background: rgba(91, 140, 245, 0.028);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .degree-left {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.2rem;
  }

  .degree-period {
    font-size: 0.78rem;
    color: var(--text-2);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .degree-institution {
    font-size: 0.82rem;
    color: var(--text-3);
    font-weight: 500;
    cursor: default;
  }

  .degree-location {
    font-size: 0.75rem;
    color: var(--text-3);
    font-weight: 400;
  }

  .degree-right {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .degree-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .degree-selective-note {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .degree-highlight {
    font-size: 0.85rem;
    color: var(--text-2);
    line-height: 1.6;
  }

  .degree-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .degree-bullets li {
    font-size: 0.88rem;
    color: var(--text-2);
    padding-left: 1rem;
    position: relative;
    line-height: 1.6;
  }
  .degree-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-3);
    font-size: 0.78rem;
  }

  .degree-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .degree-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    transition: opacity 0.2s;
  }
  .degree-link:hover { opacity: 0.7; }

  @media (max-width: 700px) {
    .degree {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 2rem 0;
    }
    .degree-left { flex-direction: row; align-items: center; gap: 1rem; flex-wrap: wrap; }
  }
</style>
