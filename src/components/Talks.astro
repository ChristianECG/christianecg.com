const typeLabel: Record<string, { es: string; en: string }> = {
  keynote:  { es: "Keynote",   en: "Keynote"    },
  talk:     { es: "Charla",    en: "Talk"        },
  mentor:   { es: "Mentoría",  en: "Mentorship"  },
  media:    { es: "Medios",    en: "Media"       },
};
---

<section id="talks">
  <div class="container">
    <div class="talks-header reveal">
      <span class="section-eyebrow">
        <span class="lang-es">Apariciones públicas</span>
        <span class="lang-en">Public appearances</span>
      </span>
      <h2 class="section-title">
        <span class="lang-es">Charlas &amp; eventos</span>
        <span class="lang-en">Talks &amp; events</span>
      </h2>
    </div>

    <div class="talks-list">
      {talks.map((t, i) => (
        <div class="talk reveal" style={`--delay: ${i * 0.04}s`}>
          <span class="talk-date">
            <span class="lang-es">{t.date_es}</span>
            <span class="lang-en">{t.date_en}</span>
          </span>
          <div class="talk-body">
            <div class="talk-title-row">
              <span class={`talk-badge talk-badge--${t.type}`}>
                <span class="lang-es">{typeLabel[t.type].es}</span>
                <span class="lang-en">{typeLabel[t.type].en}</span>
              </span>
              {t.url ? (
                <a href={t.url} target="_blank" rel="noopener" class="talk-title talk-title--link">
                  <span class="lang-es">{t.title_es}</span>
                  <span class="lang-en">{t.title_en}</span>
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              ) : (
                <span class="talk-title">
                  <span class="lang-es">{t.title_es}</span>
                  <span class="lang-en">{t.title_en}</span>
                </span>
              )}
            </div>
            <span class="talk-event">
              <span class="lang-es">{t.event_es}</span>
              <span class="lang-en">{t.event_en}</span>
              <span class="talk-format">
                · <span class="lang-es">{t.format === "online" ? "Online" : "Presencial"}</span>
                  <span class="lang-en">{t.format === "online" ? "Online" : "In person"}</span>
              </span>
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .talks-header { margin-bottom: 0; }

  .talks-list {
    display: flex;
    flex-direction: column;
  }

  .talk {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 2.5rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--border);
    align-items: start;
    --delay: 0s;
    transition-delay: var(--delay);
  }
  .talk:last-child { border-bottom: 1px solid var(--border); }

  .talk-date {
    font-size: 0.76rem;
    color: var(--text-3);
    font-weight: 500;
    letter-spacing: 0.01em;
    padding-top: 0.15rem;
    white-space: nowrap;
  }

  .talk-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .talk-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .talk-badge {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 3px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .talk-badge--keynote {
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid var(--accent-dim);
  }
  .talk-badge--talk {
    background: transparent;
    color: var(--text-3);
    border: 1px solid var(--border);
  }
  .talk-badge--mentor {
    background: transparent;
    color: var(--text-2);
    border: 1px solid var(--border);
  }
  .talk-badge--media {
    background: transparent;
    color: var(--text-3);
    border: 1px solid var(--border);
    font-style: italic;
  }

  .talk-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }

  .talk-title--link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    transition: color 0.2s;
    text-decoration: none;
  }
  .talk-title--link:hover { color: var(--accent); }
  .talk-title--link svg {
    flex-shrink: 0;
    position: relative;
    top: 0.05em;
    transition: transform 0.2s;
  }
  .talk-title--link:hover svg { transform: translateX(3px); }

  .talk-event {
    font-size: 0.8rem;
    color: var(--text-3);
    font-weight: 400;
    line-height: 1.5;
  }

  .talk-format {
    color: var(--text-3);
  }

  @media (max-width: 700px) {
    .talk {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 1.25rem 0;
    }
    .talk-date {
      font-size: 0.72rem;
    }
  }
</style>
