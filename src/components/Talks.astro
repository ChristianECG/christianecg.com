---
import { useTranslations, dataLang, pick } from '../i18n';
import type { Locale } from '../i18n';
import { talks } from '../data/talks';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const lang = dataLang(locale);

const CURRENT_THRESHOLD = 2025;
const olderCount = talks.filter(tk => parseInt(tk.date_es.split(' ').pop() ?? '0') < CURRENT_THRESHOLD).length;
---

<section id="talks">
  <div class="container">
    <div class="talks-header reveal">
      <span class="section-eyebrow">{t('talks.eyebrow')}</span>
      <h2 class="section-title" set:html={t('talks.heading')}></h2>
    </div>

    <div class="talks-list" id="talks-list">
      {talks.map((tk, i) => {
        const year = parseInt(tk.date_es.split(' ').pop() ?? '0');
        const isOlder = year < CURRENT_THRESHOLD;
        return (
        <div class={`talk spotlight reveal${isOlder ? ' talk--older' : ''}`} style={`--delay: ${i * 0.04}s`} aria-hidden={isOlder ? 'true' : undefined}>
          <span class="talk-date">{pick(tk as any, 'date', lang) as string}</span>
          <div class="talk-body">
            <div class="talk-title-row">
              <span class={`talk-badge talk-badge--${tk.type}`}>
                {t(`talks.type.${tk.type}`)}
              </span>
              {tk.url ? (
                <a href={tk.url} target="_blank" rel="noopener" class="talk-title talk-title--link">
                  {pick(tk as any, 'title', lang) as string}
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              ) : (
                <span class="talk-title">{pick(tk as any, 'title', lang) as string}</span>
              )}
            </div>
            <div class="talk-footer">
              {tk.slug && tk.slides && (
                <a href={`/${locale}/talks/${tk.slug}`} class="talk-slides-link">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 13h6M9 17h4"/>
                  </svg>
                  {t('talks.view_slides')}
                </a>
              )}
              {tk.paper && (
                <a href={`/${locale}${tk.paper}`} class="talk-slides-link">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
                  </svg>
                  {t('talks.view_paper')}
                </a>
              )}
              <span class="talk-event">
                {pick(tk as any, 'event', lang) as string}
                <span class="talk-format">
                  · {tk.format === 'online' ? 'Online' : t('talks.format_in_person')}
                </span>
              </span>
            </div>
          </div>
        </div>
        );
      })}
    </div>

    {olderCount > 0 && (
      <div class="talks-more">
        <button id="talks-toggle" class="talks-toggle-btn" aria-expanded="false">
          <span class="toggle-show">
            {t('talks.show_older').replace('%d', String(olderCount))}
          </span>
          <span class="toggle-hide">{t('talks.show_less')}</span>
          <svg class="toggle-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>
      </div>
    )}

  </div>
</section>

<style>
  .talks-header { margin-bottom: 0; }
  .talks-list { display: flex; flex-direction: column; }

  .talk {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 2.5rem;
    padding: 1.4rem 0 1.4rem 0.6rem;
    border-top: 1px solid var(--border);
    align-items: start;
    --delay: 0s;
    transition-delay: var(--delay);
    transition: background 0.25s, box-shadow 0.25s;
    border-radius: 4px;
  }
  .talk:last-child { border-bottom: 1px solid var(--border); }
  .talk:hover {
    background: rgba(91, 140, 245, 0.025);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .talk-date { font-size: 0.76rem; color: var(--text-3); font-weight: 500; letter-spacing: 0.01em; padding-top: 0.15rem; white-space: nowrap; }
  .talk-body { display: flex; flex-direction: column; gap: 0.3rem; }
  .talk-title-row { display: flex; align-items: baseline; gap: 0.65rem; flex-wrap: wrap; }

  .talk-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 3px;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .talk-badge--keynote { background: var(--accent-dim); color: var(--accent); border: 1px solid var(--accent-dim); }
  .talk-badge--talk { background: transparent; color: var(--text-3); border: 1px solid var(--border); }
  .talk-badge--mentor { background: transparent; color: var(--text-2); border: 1px solid var(--border); }
  .talk-badge--media { background: transparent; color: var(--text-3); border: 1px solid var(--border); font-style: italic; }

  .talk-title { font-size: 0.9rem; font-weight: 600; color: var(--text); line-height: 1.4; }
  .talk-title--link { display: inline-flex; align-items: baseline; gap: 0.3rem; transition: color 0.2s; text-decoration: none; }
  .talk-title--link:hover { color: var(--accent); }
  .talk-title--link svg { flex-shrink: 0; position: relative; top: 0.05em; transition: transform 0.2s; }
  .talk-title--link:hover svg { transform: translateX(3px); }

  .talk-footer { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .talk-event { font-size: 0.8rem; color: var(--text-3); font-weight: 400; line-height: 1.5; }
  .talk-format { color: var(--text-3); }

  .talk-slides-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }
  .talk-slides-link:hover { opacity: 0.7; }

  .talk--older { display: none; }
  .talks-list.talks-expanded .talk--older { display: grid; }

  .talks-more { display: flex; justify-content: center; padding: 1.5rem 0 0.5rem; border-top: 1px solid var(--border); }

  .talks-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-2);
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.5rem 1.1rem;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .talks-toggle-btn:hover { border-color: var(--border-hover); color: var(--text); }

  .toggle-hide { display: none; }
  .talks-toggle-btn[aria-expanded="true"] .toggle-show { display: none; }
  .talks-toggle-btn[aria-expanded="true"] .toggle-hide { display: inline; }

  .toggle-icon { transition: transform 0.25s ease; }
  .talks-toggle-btn[aria-expanded="true"] .toggle-icon { transform: rotate(180deg); }

  @media (max-width: 700px) {
    .talk { grid-template-columns: 1fr; gap: 0.5rem; padding: 1.25rem 0; }
    .talk-date { font-size: 0.72rem; }
  }
</style>

<script>
  function initTalks() {
    const btn = document.getElementById('talks-toggle') as HTMLButtonElement | null;
    const list = document.getElementById('talks-list');

    btn?.addEventListener('click', () => {
      const expanded = list?.classList.toggle('talks-expanded');
      btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      if (!expanded) {
        document.getElementById('talks')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

  document.addEventListener('astro:page-load', initTalks);
</script>
