---
import { useTranslations } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="about">
  <div class="container">

    <div class="about-header reveal">
      <span class="section-eyebrow">{t('about.eyebrow')}</span>
      <h2 class="about-heading">{t('about.heading')}</h2>
    </div>

    <div class="about-body reveal" style="--delay: 0.1s">
      <div class="about-bio">
        <p>{t('about.bio_1')}</p>
        <p>
          {locale === 'en' ? (
            <>I worked as a Senior Engineer at <strong>Ubidots</strong>, an IoT platform with 150K+ users and millions of real-time events. Outside of code, I'm a speaker, mentor, and published author at <strong>IEEE Xplore</strong>.</>
          ) : locale === 'lat' ? (
            <>Laboravi ut Faber Senior apud <strong>Ubidots</strong>, suggestum IoT cum CL milibus utentium et decies centenis milibus eventuum in tempore reali. Extra codicem, orator, monitor et auctor editus in <strong>IEEE Xplore</strong> sum.</>
          ) : (
            <>Trabajé como Senior Engineer en <strong>Ubidots</strong>, una plataforma IoT con más de 150K usuarios y millones de eventos en tiempo real. Fuera del código, soy speaker, mentor y autor publicado en <strong>IEEE Xplore</strong>.</>
          )}
        </p>
      </div>
    </div>

    <div class="about-facts reveal" style="--delay: 0.2s">
      <div class="fact">
        <span class="fact-num" id="fact-count" data-target="150">150K+</span>
        <span class="fact-label">{t('about.fact_label_users')}</span>
      </div>
      <div class="fact">
        <span class="fact-num">{t('about.fact_label_community')}</span>
        <span class="fact-label">Speaker · Mentor · Google DSC Lead '20–'21</span>
      </div>
      <div class="fact">
        <span class="fact-num">IEEE Xplore</span>
        <span class="fact-label">{t('about.fact_label_ieee')}</span>
      </div>
    </div>

  </div>
</section>

<style>
  .about-header {
    margin-bottom: 3rem;
  }

  .about-heading {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.15;
    margin-top: 0.75rem;
    max-width: 760px;
  }

  .about-body {
    --delay: 0s;
    transition-delay: var(--delay);
    margin-bottom: 3.5rem;
  }

  .about-bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-2);
    line-height: 1.8;
    font-size: 0.95rem;
    max-width: 620px;
  }
  .about-bio strong { color: var(--text); font-weight: 600; }

  .about-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
    --delay: 0s;
    transition-delay: var(--delay);
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.75rem 2rem 1.75rem 0;
    border-right: 1px solid var(--border);
    transition: background 0.25s;
  }
  .fact:last-child { border-right: none; }
  .fact:not(:first-child) { padding-left: 2rem; }
  .fact:hover { background: rgba(91, 140, 245, 0.025); }

  .fact-num {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .fact-label {
    font-size: 0.8rem;
    color: var(--text-3);
    font-weight: 500;
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .about-facts { grid-template-columns: 1fr; }
    .fact {
      border-right: none;
      border-top: 1px solid var(--border);
      padding: 1.25rem 0;
    }
    .fact:first-child { border-top: none; }
  }
</style>

<script>
  const el = document.getElementById('fact-count');
  if (el) {
    const target = parseInt(el.dataset.target ?? '150', 10);
    let started = false;

    const run = () => {
      if (started) return;
      started = true;
      const duration = 1400;
      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const value = Math.round(eased * target);
        el.textContent = value + 'K+';
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const obs = new IntersectionObserver(
      (entries) => { if (entries[0].isIntersecting) { run(); obs.disconnect(); } },
      { threshold: 0.5 }
    );
    obs.observe(el);
  }
</script>
