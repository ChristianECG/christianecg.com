---
import { useTranslations, dataLang, pick } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const lang = dataLang(locale);

const groups = [
  { label_es: "Frontend & Mobile",       label_en: "Frontend & Mobile",        label_lat: "Frons & Mobile",             skills: ["React", "React Native", "TypeScript", "JavaScript (ES6+)", "HTML5", "CSS3"] },
  { label_es: "Visualización de datos",  label_en: "Data Visualization",       label_lat: "Visualizatio Datarum",       skills: ["ECharts", "D3.js", "Rendering optimization", "Large dataset handling"] },
  { label_es: "Estado & fetching",       label_en: "State & Fetching",         label_lat: "Status & Captatio",          skills: ["TanStack Query", "React state patterns", "WebSockets", "REST APIs"] },
  { label_es: "Arquitectura",            label_en: "Architecture",             label_lat: "Architectura",               skills: ["Frontend Architecture", "Component Design", "Design Systems", "Scalable UI"] },
  { label_es: "Calidad & tooling",       label_en: "Quality & Tooling",        label_lat: "Qualitas & Instrumenta",     skills: ["ESLint (custom rules)", "Jest", "React Testing Library", "Git", "CI/CD"] },
  { label_es: "UX & colaboración",       label_en: "UX & Collaboration",       label_lat: "Usus & Cooperatio",          skills: ["Responsive Design", "Accessibility (a11y)", "Agile / Scrum"] },
  { label_es: "IA & LLMs",              label_en: "AI & LLMs",                label_lat: "Intelligentia Artificialis", skills: ["Claude Code", "GitHub Copilot", "OpenCode", "OpenAI API", "Codex", "Ollama"] },
];
---

<section id="skills">
  <div class="container">
    <div class="skills-header reveal">
      <span class="section-eyebrow">{t('skills.eyebrow')}</span>
      <h2 class="section-title">{t('skills.heading')}</h2>
    </div>

    <div class="skills-list">
      {groups.map((g, i) => (
        <div class="skill-row spotlight reveal" style={`--delay: ${i * 0.06}s`}>
          <span class="skill-label">
            {pick(g as any, 'label', lang) as string}
          </span>
          <div class="skill-chips">
            {g.skills.map((s: string, ci: number) => (
              <span class="skill-chip" style={`--i: ${ci}`}>{s}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-list {
    display: flex;
    flex-direction: column;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    padding: 1.5rem 0 1.5rem 0.6rem;
    border-top: 1px solid var(--border);
    align-items: baseline;
    --delay: 0s;
    transition-delay: var(--delay);
    transition: background 0.25s;
    border-radius: 4px;
  }
  .skill-row:last-child { border-bottom: 1px solid var(--border); }
  .skill-row:hover { background: rgba(91, 140, 245, 0.02); }

  .skill-label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-chip {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-2);
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: 4px;
    letter-spacing: 0.01em;
    transition: border-color 0.18s, color 0.18s, background 0.18s, transform 0.18s;
    cursor: default;
  }
  .skill-chip:hover {
    border-color: rgba(91, 140, 245, 0.35);
    color: var(--accent-light);
    background: var(--accent-dim);
    transform: translateY(-2px);
  }

  .skill-row.visible .skill-chip {
    animation: chipIn 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 0.04s);
  }

  @media (max-width: 700px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 1.25rem 0;
    }
  }
</style>
