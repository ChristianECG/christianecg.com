---
import { useTranslations, getLocaleFromUrl } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale: localeProp } = Astro.props;
const locale: Locale = localeProp ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">

    <div class="footer-brand">
      <p class="footer-logo">cecg</p>
      <p class="footer-tagline">{t('footer.tagline')}</p>
    </div>

    <nav class="footer-cols">

      <div class="footer-col">
        <p class="footer-col-label">{t('footer.pages_label')}</p>
        <ul>
          <li><a href={`/${locale}/now`}>{t('nav.now')}</a></li>
          <li><a href={`/${locale}/cv`}>CV</a></li>
          <li><a href={`/${locale}/manifiesto`}>{t('nav.manifiesto')}</a></li>
          <li><a href={`/${locale}/press`} class="footer-press-link">{t('nav.press')}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col-label">{t('footer.publications_label')}</p>
        <ul>
          <li><a href={`/${locale}/blog`}>{t('nav.blog')}</a></li>
          <li><a href="https://authorprofile.ieee.org/profiles/37089182389" target="_blank" rel="noopener">IEEE</a></li>
          <li><a href="https://datatracker.ietf.org/person/Christian%20El%C3%ADas%20Cruz%20Gonz%C3%A1lez" target="_blank" rel="noopener">IETF</a></li>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="/feed.json">JSON Feed</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col-label">{t('footer.contact_label')}</p>
        <ul>
          <li><a href="https://github.com/ChristianECG" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/christianeliascg/" target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href="mailto:contacto@christianecg.com">Email</a></li>
        </ul>
      </div>

    </nav>

  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} Christian Elías Cruz González. {t('footer.copyright_suffix')}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-top: 3.5rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .footer-tagline {
    font-size: 0.8rem;
    color: var(--text-3);
    font-weight: 500;
  }

  .footer-cols {
    display: flex;
    gap: 4rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-col-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-col a {
    font-size: 0.85rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: var(--text); }

  .footer-press-link { color: var(--accent) !important; font-weight: 600; }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding: 1.25rem 0;
  }

  .footer-bottom p {
    font-size: 0.78rem;
    color: var(--text-3);
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: 2.5rem;
    }
    .footer-cols {
      gap: 2.5rem;
      flex-wrap: wrap;
    }
  }
</style>
