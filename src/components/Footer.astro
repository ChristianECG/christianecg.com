---
import { useTranslations, getLocaleFromUrl } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale: localeProp } = Astro.props;
const locale: Locale = localeProp ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">

    <div class="footer-brand">
      <p class="footer-logo">cecg</p>
      <p class="footer-tagline">{t('footer.tagline')}</p>
      <p class="footer-location">{t('footer.location')}</p>
    </div>

    <nav class="footer-cols" aria-label={t('footer.aria')}>

      <div class="footer-col">
        <p class="footer-col-label">{t('footer.pages_label')}</p>
        <ul>
          <li><a href={`/${locale}/press`} class="footer-press-link">{t('nav.press')}</a></li>
          <li><a href={`/${locale}/cv`}>CV</a></li>
          <li><a href={`/${locale}/timeline`}>{t('nav.timeline')}</a></li>
          <li><a href={`/${locale}/manifiesto`}>{t('nav.manifiesto')}</a></li>
          <li><a href={`/${locale}/now`}>{t('nav.now')}</a></li>
          <li><a href={`/${locale}/colophon`}>{t('nav.colophon')}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col-label">{t('footer.publications_label')}</p>
        <ul>
          <li><a href={`/${locale}/blog`}>{t('nav.blog')}</a></li>
          <li><a href="https://ieeexplore.ieee.org/author/37089182389" target="_blank" rel="noopener">IEEE</a></li>
          <li><a href="https://datatracker.ietf.org/person/Christian%20El%C3%ADas%20Cruz%20Gonz%C3%A1lez" target="_blank" rel="noopener">IETF</a></li>
          <li><a href={`/${locale}/api`}>API</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col-label">{t('footer.contact_label')}</p>
        <ul>
          <li><a href="https://github.com/ChristianECG" target="_blank" rel="me noopener">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/christianeliascg/" target="_blank" rel="me noopener">LinkedIn</a></li>
          <li><a href="mailto:contacto@christianecg.com">Email</a></li>
        </ul>
      </div>

    </nav>

  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {year} Christian Elías Cruz González. {t('footer.copyright_suffix')}</p>
      <div class="footer-feeds">
        <a href="/rss.xml" title="RSS Feed">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          RSS
        </a>
        <a href="/feed.json" title="JSON Feed">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1"/>
          </svg>
          JSON Feed
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-top: 3.5rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .footer-tagline {
    font-size: 0.8rem;
    color: var(--text-2);
    font-weight: 500;
  }

  .footer-location {
    font-size: 0.75rem;
    color: var(--text-2);
  }

  .footer-cols {
    display: flex;
    gap: 4rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-col-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-col a {
    font-size: 0.85rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: var(--text); }

  .footer-press-link { color: var(--accent) !important; font-weight: 600; }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding: 1.25rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-bottom p {
    font-size: 0.78rem;
    color: var(--text-2);
  }

  .footer-feeds {
    display: flex;
    gap: 1.25rem;
  }

  .footer-feeds a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-feeds a:hover {
    color: var(--text);
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: 2.5rem;
    }
    .footer-cols {
      gap: 2.5rem;
      flex-wrap: wrap;
    }
    .footer-feeds {
      display: none;
    }
  }
</style>
