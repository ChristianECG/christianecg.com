---
import { useTranslations, getLocaleFromUrl } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale: localeProp } = Astro.props;
const locale: Locale = localeProp ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Keep the current path when switching locales
const slug = Astro.url.pathname.replace(/^\/(es|en|lat)/, '') || '/';
---

<nav class="nav" aria-label={t('nav.aria')}>
  <div class="nav-progress" id="nav-progress" aria-hidden="true"></div>
  <div class="container nav-inner">
    <a href={`/${locale}/`} class="nav-logo">cecg</a>

    <ul class="nav-links">
      <li><a href={`/${locale}/#about`}>{t('nav.about')}</a></li>
      <li><a href={`/${locale}/#experience`}>{t('nav.experience')}</a></li>
      <li><a href={`/${locale}/#education`}>{t('nav.education')}</a></li>
      <li><a href={`/${locale}/#skills`}>{t('nav.skills')}</a></li>
      <li><a href={`/${locale}/#projects`}>{t('nav.projects')}</a></li>
      <li><a href={`/${locale}/#contact`}>{t('nav.contact')}</a></li>
    </ul>

    <div class="nav-right">
      <a href={`/${locale}/blog`} class="nav-blog-btn">{t('nav.blog')}</a>
      <div class="lang-toggle">
        <a
          href={`/es${slug}`}
          class:list={['lang-btn', { active: locale === 'es' }]}
          aria-label="Español"
          aria-current={locale === 'es' ? 'true' : undefined}
        >ES</a>
        <span class="lang-sep">/</span>
        <a
          href={`/en${slug}`}
          class:list={['lang-btn', { active: locale === 'en' }]}
          aria-label="English"
          aria-current={locale === 'en' ? 'true' : undefined}
        >EN</a>
        {locale === 'lat' && (
          <>
            <span class="lang-sep">/</span>
            <a
              href={`/lat${slug}`}
              class:list={['lang-btn', 'lang-btn--lat', { active: true }]}
              aria-label="Latina"
              aria-current="true"
            >LAT</a>
          </>
        )}
      </div>

      <button class="nav-hamburger" id="nav-hamburger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<div class="nav-mobile-menu" id="nav-mobile-menu">
  <ul>
    <li><a href={`/${locale}/#about`} onclick="closeMobileMenu()">{t('nav.about')}</a></li>
    <li><a href={`/${locale}/#experience`} onclick="closeMobileMenu()">{t('nav.experience')}</a></li>
    <li><a href={`/${locale}/#education`} onclick="closeMobileMenu()">{t('nav.education')}</a></li>
    <li><a href={`/${locale}/#skills`} onclick="closeMobileMenu()">{t('nav.skills')}</a></li>
    <li><a href={`/${locale}/#projects`} onclick="closeMobileMenu()">{t('nav.projects')}</a></li>
    <li><a href={`/${locale}/#talks`} onclick="closeMobileMenu()">{t('nav.talks')}</a></li>
    <li><a href={`/${locale}/#contact`} onclick="closeMobileMenu()">{t('nav.contact')}</a></li>
    <li><a href={`/${locale}/blog`} onclick="closeMobileMenu()" class="mobile-blog-link">{t('nav.blog')}</a></li>
    <li><a href={`/${locale}/now`} onclick="closeMobileMenu()">{t('nav.now')}</a></li>
    <li><a href={`/${locale}/manifiesto`} onclick="closeMobileMenu()">{t('nav.manifiesto')}</a></li>
    <li><a href={`/${locale}/press`} onclick="closeMobileMenu()">{t('nav.press')}</a></li>
  </ul>
</div>

<script>
  // closeMobileMenu queries live elements so it survives view transitions
  (window as any).closeMobileMenu = function () {
    document.getElementById('nav-mobile-menu')?.classList.remove('open');
    document.getElementById('nav-hamburger')?.classList.remove('open');
  };

  let navGlobalBound = false;
  function bindNavGlobals() {
    if (navGlobalBound) return;
    navGlobalBound = true;

    // Konami code → /lat/
    const KONAMI = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
    let konamiIdx = 0;
    document.addEventListener('keydown', (e) => {
      if (e.key === KONAMI[konamiIdx]) {
        konamiIdx++;
        if (konamiIdx === KONAMI.length) {
          konamiIdx = 0;
          const currentPath = window.location.pathname.replace(/^\/(es|en|lat)/, '') || '/';
          window.location.href = '/lat' + currentPath;
        }
      } else {
        konamiIdx = e.key === KONAMI[0] ? 1 : 0;
      }
    });
  }

  function initNav() {
    const hamburger = document.getElementById('nav-hamburger');
    const mobileMenu = document.getElementById('nav-mobile-menu');
    hamburger?.addEventListener('click', () => {
      const open = mobileMenu?.classList.toggle('open');
      hamburger.classList.toggle('open', !!open);
    });

    // Active section highlight
    const navAnchors = document.querySelectorAll<HTMLAnchorElement>('.nav-links a');
    const secObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.id;
        navAnchors.forEach((a) => {
          a.classList.toggle('nav-active', a.getAttribute('href')?.endsWith(`#${id}`) ?? false);
        });
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('section[id]').forEach((s) => secObserver.observe(s));
  }

  document.addEventListener('astro:page-load', () => {
    bindNavGlobals();
    initNav();
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: rgba(11, 13, 18, 0.88);
    border-bottom: 1px solid var(--border);
  }

  .nav-progress {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    box-shadow: 0 0 8px rgba(70, 224, 190, 0.4);
    z-index: 101;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .nav-logo {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.04em;
    text-transform: lowercase;
    transition: opacity 0.2s;
  }
  .nav-logo:hover { opacity: 0.75; }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .nav-links a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.2s;
    position: relative;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { transform: scaleX(1); }
  .nav-links a.nav-active { color: var(--text); }
  .nav-links a.nav-active::after { transform: scaleX(1); }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-blog-btn {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 5px;
    padding: 0.35rem 0.85rem;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .nav-blog-btn:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px;
  }

  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-2);
    padding: 4px 8px;
    border-radius: 4px;
    transition: all 0.2s;
    text-decoration: none;
  }
  .lang-btn.active {
    background: var(--accent);
    color: var(--bg);
  }
  .lang-btn:not(.active):hover { color: var(--text); }

  .lang-btn--lat {
    font-size: 0.65rem;
    letter-spacing: 0.04em;
  }

  .lang-sep { color: var(--text-3); font-size: 0.7rem; display: none; }

  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .nav-hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: all 0.25s;
  }
  .nav-hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .nav-hamburger.open span:nth-child(2) { opacity: 0; }
  .nav-hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

  .nav-mobile-menu {
    display: none;
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    background: rgba(11, 13, 18, 0.98);
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 2rem 2rem;
    z-index: 99;
    backdrop-filter: blur(16px);
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
  }
  .nav-mobile-menu.open {
    opacity: 1;
    transform: none;
    pointer-events: all;
  }
  .nav-mobile-menu ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .nav-mobile-menu a {
    font-size: 1.25rem;
    font-weight: 700;
    font-family: var(--font-heading);
    color: var(--text-2);
    transition: color 0.2s;
  }
  .nav-mobile-menu a:hover { color: var(--accent); }
  .mobile-blog-link { color: var(--accent) !important; }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-hamburger { display: flex; }
    .nav-mobile-menu { display: block; }
  }
</style>
